---
/**
 * Shared page shell: head, skip link, header, main landmark, footer.
 *
 * Every route uses this, so the accessibility affordances — skip link, single
 * <main>, focus target — cannot be forgotten on a page.
 *
 * There is deliberately no scroll choreography here. The Field Sheet direction
 * is static-first: a page must be complete and correct before any interaction
 * happens, which also means nothing to disable for reduced motion and nothing
 * that breaks without JavaScript.
 */
import BaseHead from '../components/BaseHead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { site } from '../lib/site';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  path?: string;
  noindex?: boolean;
  /** Field the header sits on, so it can match the top of the page. */
  headerTone?: 'paper' | 'deep';
}

const { title, description, path, noindex, headerTone = 'paper' } = Astro.props;
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <BaseHead title={title} description={description} path={path} noindex={noindex} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader tone={headerTone} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
