---
/**
 * Contact — the page every CTA on the site resolves to.
 *
 * Two integration slots, both honest about their state today:
 *
 *   #book     BookingPanel. Renders the scheduler link once PUBLIC_BOOKING_URL
 *             is set; until then it routes to the enquiry form and says so.
 *   #enquiry  ContactForm. HubSpot-ready field names; the fieldset stays
 *             disabled with an email fallback until PUBLIC_FORM_ENDPOINT is
 *             configured, so no submission is ever silently dropped.
 *
 * This page closes on the form rather than on an Invitation sheet — it is the
 * invitation, and repeating one here would be a second ask with nowhere to go.
 */
import Sheet from '../../components/Sheet.astro';
import Label from '../../components/primitives/Label.astro';
import Mark from '../../components/primitives/Mark.astro';
import Note from '../../components/primitives/Note.astro';
import BookingPanel from '../../components/field/BookingPanel.astro';
import ContactForm from '../../components/field/ContactForm.astro';
import Masthead from '../../components/field/Masthead.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { contactDetails, contactIntro, contactMeta } from '../../data/contact';
import { integrations } from '../../lib/site';

const mastheadMeta = [
  { label: 'Response', value: 'Within one working day' },
  { label: 'Languages', value: 'English / Español' },
  { label: 'First call', value: 'Thirty minutes, no deck' },
];
---

<BaseLayout title={contactMeta.title} description={contactMeta.description} path="/contact/">
  {/* ---- 01 The opening ---------------------------------------------- */}
  <Sheet id="contact" size="open" labelledby="page-title">
    <Masthead
      index="01"
      label="Contact"
      statement={contactIntro.statement}
      lead={contactIntro.lead}
      note={contactIntro.note}
      meta={mastheadMeta}
      variant="open"
      tone="editorial"
      size={2}
    />
  </Sheet>

  {/* ---- 02 Book a call — the primary route -------------------------- */}
  <Sheet tone="signal" size="open" labelledby="booking-title">
    <BookingPanel id="book" headingId="booking-title" fallbackHref="#enquiry" />
  </Sheet>

  {/* ---- 03 The direct route ----------------------------------------- */}
  <Sheet id="direct" rule="heavy" labelledby="direct-title">
    <div class="direct">
      <div class="direct__head">
        <Mark class="direct__mark" shape="disc" tone="action" size="clamp(3rem, 6vw, 5rem)" />
        <Label
          class="direct__label"
          index={contactDetails.index}
          text={contactDetails.label}
          tone="ink"
        />
        <h2 class="display-3 direct__title" id="direct-title">{contactDetails.title}</h2>
      </div>

      <div class="direct__body">
        <a class="direct__email" href={`mailto:${integrations.contact.email}`}>
          {integrations.contact.email}
        </a>
        <p class="direct__response">{contactDetails.responseNote}</p>
        <Note class="direct__note" label="Working note" rule="top">
          Tell us the situation, the constraint and the date it matters by. That is enough for a
          useful first reply — a brief is not required to start a conversation.
        </Note>
      </div>
    </div>
  </Sheet>

  {/* ---- 04 The enquiry form ----------------------------------------- */}
  <Sheet tone="deep" labelledby="enquiry-title" class="enquiry-sheet">
    <ContactForm id="enquiry" headingId="enquiry-title" />
  </Sheet>
</BaseLayout>

<style>
  /* =====================================================================
     03 The direct route
     ===================================================================== */

  .direct {
    display: grid;
    gap: var(--space-xl);
  }

  .direct__mark {
    margin-block-end: var(--space-m);
  }

  .direct__label {
    margin-block-end: var(--space-m);
  }

  .direct__title {
    max-width: 12ch;
  }

  .direct__email {
    display: inline-block;
    font-size: var(--step-2);
    font-weight: 500;
    letter-spacing: var(--track-heading);
    color: var(--ink);
    text-decoration-color: var(--signal);
    text-decoration-thickness: var(--rule-heavy);
  }

  @media (hover: hover) {
    .direct__email:hover {
      color: var(--signal);
    }
  }

  .direct__response {
    max-width: var(--measure-short);
    margin-block-start: var(--space-m);
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--ink-soft);
  }

  .direct__note {
    margin-block-start: var(--space-xl);
  }

  @media (min-width: 60rem) {
    .direct {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: var(--space-2xl);
      align-items: start;
    }

    .direct__body {
      /* Dropped against the heading, matching the offset used on the other
         two-column sheets so the page keeps one alignment system. */
      padding-block-start: var(--space-xl);
    }
  }

  /* =====================================================================
     04 The enquiry form
     ===================================================================== */

  .enquiry-sheet :global(.form-block) {
    max-width: 62rem;
  }

  @media (min-width: 72rem) {
    .enquiry-sheet :global(.form-block) {
      /* The form is the last thing on the sheet and is stepped into the
         field, so the page ends off-axis rather than centred. */
      margin-inline-start: 12%;
    }
  }
</style>
