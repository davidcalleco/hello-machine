---
/**
 * Home.
 *
 * The page's own composition: a wide opening declaration, then the selection
 * instrument, then the argument that justifies it, then evidence, process and
 * the invitation. Each sheet has a different silhouette on purpose — the
 * shared components enforce alignment, rules and colour roles, not sameness.
 *
 * All copy comes from src/data. Nothing here invents a claim.
 */
import Sheet from '../components/Sheet.astro';
import SheetHead from '../components/SheetHead.astro';
import Action from '../components/primitives/Action.astro';
import Label from '../components/primitives/Label.astro';
import Mark from '../components/primitives/Mark.astro';
import Note from '../components/primitives/Note.astro';
import Spine from '../components/primitives/Spine.astro';
import Statement from '../components/primitives/Statement.astro';
import DefinitionList from '../components/field/DefinitionList.astro';
import EngagementIndex from '../components/field/EngagementIndex.astro';
import FaqList from '../components/field/FaqList.astro';
import Invitation from '../components/field/Invitation.astro';
import StepList from '../components/field/StepList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { faqs } from '../data/faq';
import {
  capabilitySection,
  faqSection,
  hero,
  homeMeta,
  invitation,
  judgment,
  offerSection,
  proof,
  processSection,
} from '../data/home';
import { processSteps } from '../data/process';
import { engagements } from '../data/services';
import { integrations } from '../lib/site';
---

<BaseLayout title={homeMeta.title} description={homeMeta.description} path="/">
  {/* ---- 01 Position ------------------------------------------------- */}
  <Sheet id="position" size="open" labelledby="position-title" class="position">
    <div class="position__grid">
      <Spine class="position__spine" text="Hello Machine — field sheet" tone="editorial" />

      <div class="position__head">
        <Label class="position__label" index="01" text="Position" tone="ink" />
        <Statement
          statement={hero.statement}
          as="h1"
          size={1}
          tone="editorial"
          id="position-title"
        />
      </div>

      <div class="position__aside">
        <Mark class="position__disc" shape="disc" tone="action" size="clamp(3.5rem, 8vw, 8rem)" />
        <Note label={hero.note.label} rule="side">{hero.note.body}</Note>
      </div>

      <div class="position__standfirst">
        <p class="lead position__lead">{hero.standfirst}</p>
        <div class="position__actions">
          <Action href={integrations.booking.url} size="large">Book a call</Action>
          <Action href="#offer" variant="line">The three ways to work</Action>
        </div>
      </div>

      <dl class="position__meta">
        {
          hero.meta.map((entry) => (
            <div class="position__meta-cell">
              <dt class="label">{entry.label}</dt>
              <dd>{entry.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </Sheet>

  {/* ---- 02 The offer ------------------------------------------------ */}
  <Sheet id="offer" rule="heavy" labelledby="offer-title">
    <SheetHead
      index={offerSection.index}
      label={offerSection.label}
      statement={offerSection.statement}
      note={offerSection.note}
      id="offer-title"
      size={3}
      layout="split"
    />
    <EngagementIndex engagements={engagements} />
  </Sheet>

  {/* ---- 03 The division of labour ----------------------------------- */}
  <Sheet id="judgment" tone="signal" size="open" labelledby="judgment-title" class="judgment">
    <div class="judgment__head">
      <Label class="judgment__label" index={judgment.index} text={judgment.label} tone="ink" />
      <Statement
        statement={judgment.statement}
        as="h2"
        size={2}
        tone="editorial"
        id="judgment-title"
      />
      <p class="judgment__lead">{judgment.lead}</p>
    </div>

    <div class="judgment__columns">
      {
        judgment.columns.map((column) => (
          <section class="judgment__column" aria-labelledby={`judgment-${column.key}`}>
            <p class="label judgment__column-label">{column.label}</p>
            <h3 class="judgment__column-title" id={`judgment-${column.key}`}>
              {column.title}
            </h3>
            <ul class="judgment__list" role="list">
              {column.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <p class="judgment__assurance">{judgment.assurance}</p>
  </Sheet>

  {/* ---- 04 Capability ----------------------------------------------- */}
  <Sheet id="capability" tone="deep" labelledby="capability-title">
    <SheetHead
      index={capabilitySection.index}
      label={capabilitySection.label}
      statement={capabilitySection.statement}
      note={capabilitySection.note}
      id="capability-title"
      size={3}
      layout="stack"
    />
    <DefinitionList items={capabilitySection.items} columns={2} numbered />
  </Sheet>

  {/* ---- 05 Evidence ------------------------------------------------- */}
  <Sheet id="evidence" rule="hair" labelledby="evidence-title">
    <SheetHead
      index={proof.index}
      label={proof.label}
      statement={proof.statement}
      lead={proof.lead}
      id="evidence-title"
      size={3}
      layout="offset"
    />

    <ol class="evidence" role="list">
      {
        proof.points.map((point) => (
          <li class="evidence__point">
            <p class="label evidence__index">{point.index}</p>
            <h3 class="evidence__title">{point.title}</h3>
            <p class="evidence__description">{point.description}</p>
          </li>
        ))
      }
    </ol>

    <Action class="evidence__action" href={proof.action.href} variant="ghost">
      {proof.action.label}
    </Action>
  </Sheet>

  {/* ---- 06 Process -------------------------------------------------- */}
  <Sheet id="process" size="tight" rule="hair" labelledby="process-title">
    <SheetHead
      index={processSection.index}
      label={processSection.label}
      statement={processSection.statement}
      note={processSection.note}
      id="process-title"
      size={3}
      layout="split"
    />
    <StepList steps={processSteps} variant="compact" />
    <Action class="process__action" href={processSection.action.href} variant="line">
      {processSection.action.label}
    </Action>
  </Sheet>

  {/* ---- 07 Questions ------------------------------------------------ */}
  <Sheet id="questions" tone="deep" labelledby="questions-title">
    <SheetHead
      index={faqSection.index}
      label={faqSection.label}
      statement={faqSection.statement}
      id="questions-title"
      size={3}
      layout="stack"
    />
    <FaqList faqs={faqs} />
  </Sheet>

  {/* ---- 08 Invitation ----------------------------------------------- */}
  <Invitation
    index={invitation.index}
    label={invitation.label}
    statement={invitation.statement}
    lead={invitation.lead}
    expectations={invitation.expectations}
  />
</BaseLayout>

<style>
  /* =====================================================================
     01 Position — the declaration
     ===================================================================== */

  .position__grid {
    display: grid;
    gap: var(--space-xl);
  }

  .position__label {
    margin-block-end: var(--space-m);
  }

  .position__disc {
    margin-block-end: var(--space-l);
  }

  .position__lead {
    max-width: 30ch;
    font-size: var(--step-2);
    line-height: 1.15;
  }

  .position__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m);
    margin-block-start: var(--space-xl);
  }

  .position__meta {
    display: grid;
    gap: var(--space-m);
    margin: 0;
    padding-block-start: var(--space-s);
    border-block-start: var(--rule-hair) solid var(--rule);
  }

  .position__meta dt {
    margin-block-end: var(--space-3xs);
  }

  .position__meta dd {
    margin: 0;
    font-size: var(--step--1);
    letter-spacing: var(--track-tight);
  }

  @media (min-width: 40rem) {
    .position__meta {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-l);
    }
  }

  @media (min-width: 64rem) {
    .position__grid {
      grid-template-columns: auto minmax(0, 1fr) var(--width-note);
      column-gap: var(--space-2xl);
      row-gap: var(--space-2xl);
      align-items: start;
    }

    .position__spine {
      grid-row: 1 / 3;
      align-self: stretch;
    }

    .position__head {
      grid-column: 2 / 4;
    }

    .position__aside {
      grid-column: 3;
      grid-row: 2;
    }

    .position__standfirst {
      grid-column: 2;
      grid-row: 2;
      /* Stepped in from the headline: the eye drops and moves right, which is
         the asymmetry the direction asks for. */
      padding-inline-start: 14%;
    }

    .position__meta {
      grid-column: 2 / 4;
      margin-block-start: var(--space-l);
    }
  }

  /* =====================================================================
     03 The division of labour — the one loud field on this page
     ===================================================================== */

  .judgment__label {
    margin-block-end: var(--space-m);
  }

  .judgment__lead {
    max-width: var(--measure);
    margin-block-start: var(--space-l);
    font-size: var(--step-1);
    line-height: 1.3;
    letter-spacing: var(--track-tight);
    color: var(--ink-soft);
  }

  .judgment__columns {
    display: grid;
    gap: var(--space-xl);
    margin-block-start: var(--space-2xl);
  }

  .judgment__column {
    padding-block-start: var(--space-s);
    border-block-start: var(--rule-heavy) solid var(--rule-strong);
  }

  .judgment__column-label {
    color: var(--ink-soft);
  }

  .judgment__column-title {
    max-width: 18ch;
    margin-block-start: var(--space-2xs);
    font-size: var(--step-2);
    font-weight: 500;
    line-height: var(--leading-tight);
    letter-spacing: var(--track-heading);
  }

  .judgment__list {
    display: grid;
    gap: 0;
    margin: var(--space-l) 0 0;
    padding: 0;
  }

  .judgment__list > li {
    padding-block: var(--space-xs);
    border-block-end: var(--rule-hair) solid var(--rule);
    font-size: var(--step--1);
    line-height: 1.4;
  }

  .judgment__assurance {
    max-width: 40ch;
    margin-block-start: var(--space-2xl);
    padding-inline-start: var(--space-m);
    border-inline-start: var(--rule-heavy) solid var(--editorial);
    font-size: var(--step-1);
    line-height: 1.28;
    letter-spacing: var(--track-tight);
  }

  @media (min-width: 56rem) {
    .judgment__columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-2xl);
    }
  }

  @media (min-width: 64rem) {
    .judgment__assurance {
      margin-inline-start: 50%;
    }
  }

  /* =====================================================================
     05 Evidence
     ===================================================================== */

  .evidence {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-start: var(--rule-heavy) solid var(--rule-strong);
  }

  .evidence__point {
    padding-block: var(--space-l);
    border-block-end: var(--rule-hair) solid var(--rule);
  }

  .evidence__index {
    color: var(--signal);
  }

  .evidence__title {
    max-width: 16ch;
    margin-block-start: var(--space-s);
    font-size: var(--step-2);
    font-weight: 500;
    line-height: var(--leading-tight);
    letter-spacing: var(--track-heading);
  }

  .evidence__description {
    max-width: 40ch;
    margin-block-start: var(--space-s);
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--ink-soft);
  }

  .evidence__action {
    margin-block-start: var(--space-xl);
  }

  @media (min-width: 56rem) {
    .evidence {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--space-l);
    }

    .evidence__point + .evidence__point {
      padding-inline-start: var(--space-l);
      border-inline-start: var(--rule-hair) solid var(--rule);
    }
  }

  /* =====================================================================
     06 Process
     ===================================================================== */

  .process__action {
    margin-block-start: var(--space-xl);
  }
</style>
