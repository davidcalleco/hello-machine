---
import BaseLayout from '../layouts/BaseLayout.astro';
import { offers } from '../data/home';
import { integrations } from '../lib/site';
---

<BaseLayout
  title="Hello Machine — Expert-led websites, accelerated by AI"
  description="Expert-led websites, accelerated by AI."
  path="/"
  headerTheme="ink"
>
  <header class="site-header">
    <a class="wordmark" href="/">HELLO MACHINE<span>●</span></a><nav>
      <a href="#index">Ways to work</a><a class="book" href={integrations.booking.url}
        >Book a call ↗</a
      >
    </nav>
  </header>
  <main>
    <section class="hero">
      <div class="eyebrow">Independent digital studio / Bogotá + worldwide</div><h1>
        Expert-led<br />websites,<br /><i>accelerated</i><br />by AI.
      </h1><div class="hero-aside">
        <p>We make complex digital work clear, useful, and ready for what comes next.</p><a
          class="circle-link"
          href="#index"
          aria-label="See ways to work">↓</a
        >
      </div><div class="hero-foot">
        <span>01—05 / Position</span><span>Strategy · Design · Build · Care</span>
      </div>
    </section>
    <section id="index" class="index-section">
      <div class="section-kicker">02 / The living index</div><div class="index-layout">
        <div class="index-list" role="tablist" aria-label="Ways to work with Hello Machine">
          {
            offers.slice(0, 3).map((offer, index) => (
              <button
                class:list={['index-item', { active: index === 0 }]}
                role="tab"
                aria-selected={index === 0}
                aria-controls={`response-${index}`}
                id={`tab-${index}`}
                data-index={index}
              >
                <>
                  <span class="index-number">0{index + 1}</span>
                  <span class="index-title">{offer.name}</span>
                  <span class="index-arrow" aria-hidden="true">
                    ↗
                  </span>
                </>
              </button>
            ))
          }
        </div><div class="response-panel" aria-live="polite">
          {
            offers.slice(0, 3).map((offer, index) => (
              <div
                class:list={['response', { active: index === 0 }]}
                id={`response-${index}`}
                role="tabpanel"
                aria-labelledby={`tab-${index}`}
                data-response={index}
              >
                <>
                  <span class="response-label">
                    {offer.index} / {offer.bestFor}
                  </span>
                  <h2>{offer.summary}</h2>
                  <p>{offer.includes.slice(0, 3).join(' · ')}</p>
                  <a class="text-link" href={offer.action.href}>
                    {offer.action.label} ↗
                  </a>
                </>
              </div>
            ))
          }
        </div>
      </div>
    </section>
    <section class="statement">
      <div class="section-kicker">03 / The difference</div><div class="statement-grid">
        <h2>More leverage.<br /><em>Still human.</em></h2><div>
          <p>
            AI helps us move faster through research, iteration, and operations. Experienced people
            decide what matters, what should ship, and what should never leave the studio.
          </p><p class="small">
            Every meaningful stage has a human owner: strategy, design, implementation, SEO/AEO,
            quality, maintenance, and improvement.
          </p>
        </div>
      </div>
    </section>
    <section class="experience">
      <div class="section-kicker">04 / Selected experience</div><div class="experience-grid">
        <div><span class="index-number">01</span><h2>Useful work<br />over loud work.</h2></div><div
          class="experience-note"
        >
          <p>
            Founder-led delivery across websites, digital systems, and the details that make them
            hold together.
          </p><p class="small">
            Selected experience and case studies will be added here as they are approved for public
            use.
          </p><a class="text-link" href="/work">See the experience ↗</a>
        </div>
      </div>
    </section>
    <section class="closing">
      <div class="section-kicker">05 / Next</div><h2>
        Bring the signal.<br />We’ll shape the response.
      </h2><a class="primary" href={integrations.booking.url}>Book a call ↗</a><a
        class="secondary"
        href="/contact">Or send a note</a
      >
    </section>
  </main>
</BaseLayout>
<script>
  const items = document.querySelectorAll<HTMLButtonElement>('.index-item');
  const responses = document.querySelectorAll<HTMLElement>('.response');
  items.forEach((item) =>
    item.addEventListener('click', () => {
      const index = item.dataset.index;
      items.forEach((el) => {
        const active = el === item;
        el.classList.toggle('active', active);
        el.setAttribute('aria-selected', String(active));
      });
      responses.forEach((panel) =>
        panel.classList.toggle('active', panel.dataset.response === index),
      );
    }),
  );
</script>
<style>
  :global(html) {
    scroll-behavior: smooth;
  }
  :global(body) {
    margin: 0;
    background: #fff;
    color: #111;
    font-family: Arial, sans-serif;
  }
  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px 4vw;
    border-bottom: 1px solid #111;
    font-size: 13px;
    font-weight: 700;
  }
  .site-header a {
    color: inherit;
    text-decoration: none;
  }
  .wordmark span {
    color: #ff5038;
    margin-left: 4px;
  }
  .site-header nav {
    display: flex;
    gap: 28px;
    align-items: center;
  }
  .book,
  .primary {
    background: #111;
    color: #fff !important;
    padding: 13px 18px;
    border-radius: 100px;
  }
  .hero,
  .index-section,
  .statement,
  .experience,
  .closing {
    padding: 7vw 4vw;
  }
  .hero {
    min-height: 680px;
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-content: start;
    border-bottom: 1px solid #111;
  }
  .eyebrow,
  .section-kicker,
  .response-label,
  .hero-foot {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .hero h1 {
    font-size: clamp(70px, 12vw, 175px);
    line-height: 0.78;
    letter-spacing: -0.095em;
    margin: 10vh 0 0;
    grid-column: 1/3;
  }
  .hero h1 i {
    font-style: normal;
    color: #ff5038;
  }
  .hero-aside {
    grid-column: 2;
    display: flex;
    justify-content: space-between;
    align-items: end;
    margin-top: 5vh;
    max-width: 470px;
    font: clamp(20px, 2.6vw, 34px)/1.05 Georgia;
  }
  .circle-link {
    border: 1px solid #111;
    border-radius: 50%;
    width: 70px;
    height: 70px;
    display: grid;
    place-items: center;
    color: #111;
    text-decoration: none;
    font: 24px Arial;
  }
  .hero-foot {
    position: absolute;
    bottom: 25px;
    left: 4vw;
    right: 4vw;
    display: flex;
    justify-content: space-between;
    border-top: 1px solid #111;
    padding-top: 12px;
  }
  .index-section {
    background: #fff;
  }
  .index-layout {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    margin-top: 5vw;
  }
  .index-list {
    border-top: 2px solid #111;
  }
  .index-item {
    width: 100%;
    display: grid;
    grid-template-columns: 10% 1fr 8%;
    align-items: center;
    background: #fff;
    border: 0;
    border-bottom: 1px solid #bbb;
    padding: 24px 0;
    text-align: left;
    cursor: pointer;
    color: #111;
  }
  .index-item:hover,
  .index-item:focus-visible,
  .index-item.active {
    background: #c8ff4d;
    padding-left: 15px;
    padding-right: 15px;
  }
  .index-item:focus-visible {
    outline: 2px solid #ff5038;
    outline-offset: -2px;
  }
  .index-number {
    font-size: 12px;
  }
  .index-title {
    font-size: clamp(28px, 4vw, 64px);
    letter-spacing: -0.06em;
  }
  .index-arrow {
    font-size: 26px;
  }
  .response-panel {
    padding: 4vw 0 0 7vw;
  }
  .response {
    display: none;
  }
  .response.active {
    display: block;
  }
  .response h2 {
    font-size: clamp(38px, 5vw, 74px);
    line-height: 0.88;
    letter-spacing: -0.075em;
    margin: 25px 0;
  }
  .response p,
  .statement p,
  .experience-note p {
    font-size: 18px;
    line-height: 1.3;
    max-width: 390px;
  }
  .text-link {
    display: inline-block;
    margin-top: 22px;
    color: #111;
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .statement {
    background: #f2f2ed;
    border-top: 1px solid #111;
  }
  .statement-grid,
  .experience-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8vw;
    margin-top: 6vw;
  }
  .statement h2,
  .experience h2 {
    font-size: clamp(55px, 8vw, 120px);
    line-height: 0.8;
    letter-spacing: -0.085em;
    margin: 0;
  }
  .statement em {
    font-style: normal;
    color: #ff5038;
  }
  .small {
    font-size: 14px !important;
    color: #686863;
  }
  .experience {
    border-top: 1px solid #111;
  }
  .experience-note {
    padding-top: 2vw;
  }
  .closing {
    background: #c8ff4d;
    border-top: 1px solid #111;
    min-height: 430px;
  }
  .closing h2 {
    font-size: clamp(60px, 10vw, 150px);
    line-height: 0.78;
    letter-spacing: -0.09em;
    margin: 9vw 0 5vw;
  }
  .primary,
  .secondary {
    display: inline-block;
    text-decoration: none;
    margin-right: 18px;
  }
  .secondary {
    color: #111;
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  @media (max-width: 720px) {
    .site-header {
      padding: 18px 6vw;
    }
    .site-header nav a:first-child {
      display: none;
    }
    .hero,
    .index-section,
    .statement,
    .experience,
    .closing {
      padding: 15vw 6vw;
    }
    .hero {
      min-height: 680px;
      display: block;
    }
    .hero h1 {
      font-size: 22vw;
      margin-top: 18vh;
    }
    .hero-aside {
      margin-top: 12vh;
    }
    .hero-foot {
      left: 6vw;
      right: 6vw;
      display: block;
      line-height: 2;
    }
    .hero-foot span {
      display: block;
    }
    .index-layout,
    .statement-grid,
    .experience-grid {
      display: block;
    }
    .response-panel {
      padding: 14vw 0 0;
    }
    .index-title {
      font-size: 9vw;
    }
    .statement-grid > div {
      margin-top: 14vw;
    }
    .experience-note {
      padding-top: 12vw;
    }
    .closing h2 {
      font-size: 17vw;
      margin: 25vw 0 12vw;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
    .index-item {
      transition: none;
    }
  }
</style>
