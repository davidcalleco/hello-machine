---
/**
 * Homepage v2: a sequence of distinct scenes. Content/data stays in modules;
 * each component owns one purposeful composition and progressive enhancement.
 */
import HeroAssembly from '../components/home/HeroAssembly.astro';
import WorkCatalogue from '../components/home/WorkCatalogue.astro';
import ProcessScene from '../components/home/ProcessScene.astro';
import OfferScene from '../components/home/OfferScene.astro';
import HumanAiScene from '../components/home/HumanAiScene.astro';
import Invitation from '../components/field/Invitation.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { homeMeta, invitation } from '../data/home';
---

<BaseLayout title={homeMeta.title} description={homeMeta.description} path="/">
  <HeroAssembly />
  <WorkCatalogue />
  <ProcessScene />
  <OfferScene />
  <HumanAiScene />
  <Invitation
    index="05"
    label="Start here"
    statement={{ lead: 'Bring the', mark: 'problem', tail: '.' }}
    lead="Tell us what needs to be clearer, faster or more useful. We will tell you what we would do next."
    expectations={invitation.expectations.slice(0, 2)}
  />
</BaseLayout>
