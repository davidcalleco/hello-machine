---
/**
 * A practice page: /services/websites/, /services/ai-systems/,
 * /services/automation/.
 *
 * One route, three sheets of the same catalogue — so the practices cannot
 * drift apart in structure while the content differs. The masthead uses the
 * `indexed` variant with a spine, because a practice is one item out of
 * several rather than the front of the publication.
 *
 * Every string is read from src/data/services.ts. If a practice turns out not
 * to be commercially real for launch, deleting it from `practices` deletes
 * this route with it.
 */
import Sheet from '../../components/Sheet.astro';
import SheetHead from '../../components/SheetHead.astro';
import Action from '../../components/primitives/Action.astro';
import Label from '../../components/primitives/Label.astro';
import Mark from '../../components/primitives/Mark.astro';
import Note from '../../components/primitives/Note.astro';
import DefinitionList from '../../components/field/DefinitionList.astro';
import IndexRow from '../../components/field/IndexRow.astro';
import Invitation from '../../components/field/Invitation.astro';
import Masthead from '../../components/field/Masthead.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEngagements, practices } from '../../data/services';
import type { Practice } from '../../data/types';

export function getStaticPaths() {
  return practices.map((practice) => ({
    params: { slug: practice.slug },
    props: { practice },
  }));
}

interface Props {
  practice: Practice;
}

const { practice } = Astro.props;

const related = getEngagements(practice.engagementIds);
const others = practices.filter((entry) => entry.slug !== practice.slug);

const mastheadMeta = [
  { label: 'Practice', value: `${practice.index} of ${String(practices.length).padStart(2, '0')}` },
  { label: 'Bought as', value: related.map((engagement) => engagement.name).join(' / ') },
  { label: 'Led by', value: 'A named person, accountable after launch' },
];
---

<BaseLayout
  title={practice.meta.title}
  description={practice.meta.description}
  path={`/services/${practice.slug}/`}
>
  {/* ---- 01 The entry ------------------------------------------------ */}
  <Sheet id="practice" size="open" labelledby="page-title">
    <Masthead
      index={practice.index}
      label={`Practice — ${practice.shortName}`}
      statement={practice.statement}
      lead={practice.lead}
      spine={`${practice.index} — ${practice.name}`}
      meta={mastheadMeta}
      variant="indexed"
      tone="editorial"
      size={2}
    />
  </Sheet>

  {/* ---- 02 Definition ----------------------------------------------- */}
  <Sheet id="definition" rule="heavy" labelledby="definition-title">
    <SheetHead
      index="02"
      label="Definition"
      statement={{ lead: 'What this', mark: 'actually covers', tail: '.' }}
      id="definition-title"
      size={3}
      layout="split"
      note={practice.summary}
    />

    <div class="definition">
      <div class="prose definition__body">
        {practice.definition.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <div class="definition__aside">
        <Mark class="definition__mark" shape="ring" tone="signal" size="clamp(2.5rem, 5vw, 4rem)" />
        <Note label="Engagement" rule="side">{practice.engagementNote}</Note>
      </div>
    </div>
  </Sheet>

  {/* ---- 03 Deliverables --------------------------------------------- */}
  <Sheet id="deliverables" tone="deep" labelledby="deliverables-title">
    <SheetHead
      index="03"
      label="Deliverables"
      statement={{ lead: 'What you', mark: 'actually receive', tail: '.' }}
      id="deliverables-title"
      size={3}
      layout="stack"
    />
    <DefinitionList items={practice.deliverables} columns={2} numbered />
  </Sheet>

  {/* ---- 04 Signals and boundaries — the loud field ------------------ */}
  <Sheet id="signals" tone="signal" size="open" labelledby="signals-title">
    <div class="signals__head">
      <Label class="signals__label" index="04" text="Signals" tone="ink" />
      <h2 class="display-2 signals__title" id="signals-title">
        Reasons people <em class="mark-serif mark-serif--signal">call us</em>.
      </h2>
    </div>

    <div class="signals__columns">
      <section class="signals__column" aria-labelledby="signals-when">
        <p class="label signals__column-label">When it is time</p>
        <h3 class="signals__column-title" id="signals-when">You recognise one of these.</h3>
        <ul class="signals__list" role="list">
          {practice.signals.map((signal) => <li>{signal}</li>)}
        </ul>
      </section>

      <section class="signals__column signals__column--boundary" aria-labelledby="signals-not">
        <p class="label signals__column-label">Where we stop</p>
        <h3 class="signals__column-title" id="signals-not">And what we will not do.</h3>
        <ul class="signals__list" role="list">
          {practice.boundaries.map((boundary) => <li>{boundary}</li>)}
        </ul>
      </section>
    </div>
  </Sheet>

  {/* ---- 05 The division of labour ----------------------------------- */}
  <Sheet id="division" rule="hair" labelledby="division-title">
    <SheetHead
      index="05"
      label="Division of labour"
      statement={{ lead: 'Who does', mark: 'what', tail: ', exactly.' }}
      id="division-title"
      size={3}
      layout="offset"
      note="Published so you can check it. If the line moves on your engagement, we tell you where it moved to."
    />

    <div class="division">
      <section class="division__column" aria-labelledby="division-human">
        <p class="label division__label">People run at</p>
        <h3 class="division__title" id="division-human">Judgment, taste and accountability.</h3>
        <ul class="division__list" role="list">
          {practice.division.human.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section class="division__column" aria-labelledby="division-machine">
        <p class="label division__label">The machine runs at</p>
        <h3 class="division__title" id="division-machine">Volume, drafts and repetition.</h3>
        <ul class="division__list" role="list">
          {practice.division.machine.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    </div>
  </Sheet>

  {/* ---- 06 How it is bought ----------------------------------------- */}
  <Sheet id="engagement" size="tight" rule="hair" labelledby="engagement-title">
    <SheetHead
      index="06"
      label="How it is bought"
      statement={{ lead: 'Available as', mark: 'these engagements', tail: '.' }}
      id="engagement-title"
      size={3}
      layout="split"
      note={practice.engagementNote}
    />

    <div class="related">
      {
        related.map((engagement) => (
          <IndexRow
            index={engagement.index}
            name={engagement.name}
            line={engagement.line}
            href={`/services/#${engagement.id}`}
          />
        ))
      }
    </div>

    <div class="others">
      <p class="label others__label">Other practices</p>
      {
        others.map((entry) => (
          <IndexRow
            index={entry.index}
            name={entry.name}
            line={entry.summary}
            href={`/services/${entry.slug}/`}
          />
        ))
      }
      <Action class="others__action" href="/services/" variant="line">The full catalogue</Action>
    </div>
  </Sheet>

  {/* ---- 07 Invitation ----------------------------------------------- */}
  <Invitation
    index="07"
    label="Invitation"
    statement={{
      lead: 'Describe the situation.',
      mark: 'We will tell you',
      tail: ' what it needs.',
    }}
    lead="Thirty minutes is usually enough to say whether this practice is the right one, what the work would involve, and whether we are the right studio for it."
    expectations={[
      'You describe the situation, the constraints and the deadline',
      'We ask the questions that change the recommendation',
      'A written scope and a number follow if it is a fit',
    ]}
  />
</BaseLayout>

<style>
  /* =====================================================================
     02 Definition
     ===================================================================== */

  .definition {
    display: grid;
    gap: var(--space-xl);
  }

  .definition__body > p {
    font-size: var(--step-0);
  }

  .definition__mark {
    margin-block-end: var(--space-m);
  }

  @media (min-width: 64rem) {
    .definition {
      grid-template-columns: minmax(0, 1fr) var(--width-note);
      column-gap: var(--space-2xl);
      align-items: start;
    }

    .definition__body {
      padding-inline-start: 16%;
    }
  }

  /* =====================================================================
     04 Signals — the one loud field on the page
     ===================================================================== */

  .signals__label {
    margin-block-end: var(--space-m);
  }

  .signals__title {
    max-width: 14ch;
  }

  .signals__columns {
    display: grid;
    gap: var(--space-xl);
    margin-block-start: var(--space-2xl);
  }

  .signals__column {
    padding-block-start: var(--space-s);
    border-block-start: var(--rule-heavy) solid var(--rule-strong);
  }

  .signals__column-label {
    color: var(--ink-soft);
  }

  .signals__column-title {
    max-width: 20ch;
    margin-block-start: var(--space-2xs);
    font-size: var(--step-2);
    font-weight: 500;
    line-height: var(--leading-tight);
    letter-spacing: var(--track-heading);
  }

  .signals__list {
    display: grid;
    gap: 0;
    margin: var(--space-l) 0 0;
    padding: 0;
  }

  .signals__list > li {
    padding-block: var(--space-xs);
    border-block-end: var(--rule-hair) solid var(--rule);
    font-size: var(--step--1);
    line-height: 1.4;
  }

  @media (min-width: 56rem) {
    .signals__columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-2xl);
    }

    /* The boundary column is dropped a step: it answers the first, it does
       not sit beside it as an equal claim. */
    .signals__column--boundary {
      margin-block-start: var(--space-2xl);
    }
  }

  /* =====================================================================
     05 Division of labour
     ===================================================================== */

  .division {
    display: grid;
    gap: var(--space-xl);
  }

  .division__column {
    padding-block-start: var(--space-s);
    border-block-start: var(--rule-heavy) solid var(--rule-strong);
  }

  .division__title {
    max-width: 20ch;
    margin-block-start: var(--space-2xs);
    font-size: var(--step-1);
    font-weight: 500;
    line-height: var(--leading-snug);
    letter-spacing: var(--track-tight);
  }

  .division__list {
    display: grid;
    gap: 0;
    margin: var(--space-m) 0 0;
    padding: 0;
  }

  .division__list > li {
    padding-block: var(--space-xs);
    border-block-end: var(--rule-hair) solid var(--rule);
    font-size: var(--step--1);
    line-height: 1.4;
    color: var(--ink-soft);
  }

  @media (min-width: 56rem) {
    .division {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-2xl);
    }
  }

  /* =====================================================================
     06 How it is bought
     ===================================================================== */

  .related {
    border-block-start: var(--rule-heavy) solid var(--rule-strong);
  }

  .others {
    margin-block-start: var(--space-2xl);
  }

  .others__label {
    margin-block-end: var(--space-2xs);
  }

  .others__action {
    margin-block-start: var(--space-l);
  }

  @media (min-width: 56rem) {
    .others {
      /* The footnote position: indented, quieter, clearly secondary to the
         engagement index above it. */
      margin-inline-start: 34%;
    }
  }
</style>
