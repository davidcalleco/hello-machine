---
/**
 * 404 — the address is not on the sheet.
 *
 * Kept as a composed page rather than a bare apology: a visitor who lands
 * here still gets the site's index, which is usually what they wanted.
 * Excluded from the sitemap (see astro.config.mjs) and marked noindex.
 */
import Sheet from '../components/Sheet.astro';
import Action from '../components/primitives/Action.astro';
import Label from '../components/primitives/Label.astro';
import Mark from '../components/primitives/Mark.astro';
import Note from '../components/primitives/Note.astro';
import Statement from '../components/primitives/Statement.astro';
import IndexRow from '../components/field/IndexRow.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { notFound } from '../data/legal';
import { nav } from '../lib/site';
import { practices } from '../data/services';
---

<BaseLayout
  title={notFound.meta.title}
  description={notFound.meta.description}
  path="/404/"
  noindex
>
  <Sheet id="not-found" size="open" labelledby="page-title">
    <div class="lost">
      <div class="lost__head">
        <Label class="lost__label" index="404" text="No such sheet" tone="ink" />
        <Statement
          statement={notFound.statement}
          as="h1"
          size={2}
          tone="editorial"
          id="page-title"
        />
        <p class="lead lost__lead">{notFound.lead}</p>
        <Action class="lost__action" href="/" variant="ghost">Back to the front</Action>
      </div>

      <div class="lost__aside">
        <Mark class="lost__mark" shape="cross" tone="editorial" size="clamp(3rem, 7vw, 6rem)" />
        <Note label="If a link sent you here" rule="side">{notFound.note}</Note>
      </div>
    </div>
  </Sheet>

  <Sheet id="index" tone="deep" rule="heavy" labelledby="index-title">
    <h2 class="label index-title" id="index-title">Everything the site holds</h2>

    <div class="site-index">
      <div class="site-index__column">
        <p class="label site-index__label">Pages</p>
        {nav.map((item) => <IndexRow index={item.index} name={item.label} href={item.href} />)}
      </div>

      <div class="site-index__column">
        <p class="label site-index__label">Practices</p>
        {
          practices.map((practice) => (
            <IndexRow
              index={practice.index}
              name={practice.name}
              href={`/services/${practice.slug}/`}
            />
          ))
        }
      </div>
    </div>
  </Sheet>
</BaseLayout>

<style>
  .lost {
    display: grid;
    gap: var(--space-2xl);
  }

  .lost__label {
    margin-block-end: var(--space-m);
  }

  .lost__lead {
    margin-block-start: var(--space-l);
    max-width: 38ch;
    color: var(--ink-soft);
  }

  .lost__action {
    margin-block-start: var(--space-xl);
  }

  .lost__mark {
    margin-block-end: var(--space-m);
  }

  @media (min-width: 60rem) {
    .lost {
      grid-template-columns: minmax(0, 1fr) var(--width-note);
      column-gap: var(--space-2xl);
      align-items: start;
    }

    .lost__aside {
      padding-block-start: var(--space-xl);
    }
  }

  .index-title {
    margin-block-end: var(--space-l);
    color: var(--ink);
  }

  .site-index {
    display: grid;
    gap: var(--space-xl);
  }

  .site-index__label {
    padding-block-end: var(--space-2xs);
    border-block-end: var(--rule-heavy) solid var(--rule-strong);
  }

  @media (min-width: 46rem) {
    .site-index {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-2xl);
    }
  }
</style>
