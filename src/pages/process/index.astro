---
/**
 * Process — the sequence, written out in full.
 *
 * The homepage runs the compact strip; this page runs the same five steps in
 * `full` variant, where each step names its outputs and the person answerable
 * for it. That accountability line is the point of the page, so it gets the
 * editorial rule rather than a footnote.
 */
import Sheet from '../../components/Sheet.astro';
import SheetHead from '../../components/SheetHead.astro';
import Action from '../../components/primitives/Action.astro';
import Label from '../../components/primitives/Label.astro';
import Mark from '../../components/primitives/Mark.astro';
import FaqList from '../../components/field/FaqList.astro';
import Invitation from '../../components/field/Invitation.astro';
import Masthead from '../../components/field/Masthead.astro';
import StepList from '../../components/field/StepList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  processFaqs,
  processIntro,
  processMeta,
  processPrinciples,
  processSteps,
} from '../../data/process';

const mastheadMeta = [
  { label: 'Steps', value: processSteps.map((step) => step.name).join(' · ') },
  { label: 'On a subscription', value: 'The sequence repeats, continuously' },
  { label: 'On an intervention', value: 'The sequence compresses, never skips' },
];
---

<BaseLayout title={processMeta.title} description={processMeta.description} path="/process/">
  {/* ---- 01 The sequence --------------------------------------------- */}
  <Sheet id="process" size="open" labelledby="page-title">
    <Masthead
      index="01"
      label="Process"
      statement={processIntro.statement}
      lead={processIntro.lead}
      note={processIntro.note}
      meta={mastheadMeta}
      variant="open"
      tone="editorial"
      size={2}
    />
  </Sheet>

  {/* ---- 02 The five steps ------------------------------------------- */}
  <Sheet id="steps" rule="heavy" labelledby="steps-title">
    <SheetHead
      index="02"
      label="The sequence"
      statement={{ lead: 'Five steps, and who is', mark: 'answerable', tail: ' for each.' }}
      id="steps-title"
      size={3}
      layout="stack"
      note="The owner line is not decoration. If you cannot name who is answerable for a step, that step does not really have a process."
    />
    <StepList steps={processSteps} variant="full" />
  </Sheet>

  {/* ---- 03 How we work — the loud field ------------------------------ */}
  <Sheet id="principles" tone="signal" size="open" labelledby="principles-title">
    <div class="working__head">
      <Mark class="working__mark" shape="tick" tone="editorial" size="clamp(2rem, 4vw, 3.5rem)" />
      <Label class="working__label" index="03" text="Working rules" tone="ink" />
      <h2 class="display-2 working__title" id="principles-title">
        The parts that are <em class="mark-serif mark-serif--signal">not negotiable</em>.
      </h2>
    </div>

    <ol class="working" role="list">
      {
        processPrinciples.map((principle) => (
          <li class="working__item">
            <p class="label working__index">{principle.index}</p>
            <h3 class="working__name">{principle.title}</h3>
            <p class="working__description">{principle.description}</p>
          </li>
        ))
      }
    </ol>
  </Sheet>

  {/* ---- 04 Questions about running it ------------------------------- */}
  <Sheet id="questions" tone="deep" labelledby="questions-title">
    <SheetHead
      index="04"
      label="Questions"
      statement={{ lead: 'What running this', mark: 'asks of you', tail: '.' }}
      id="questions-title"
      size={3}
      layout="split"
      note="More questions about the offer itself are answered on the homepage index."
    />
    <FaqList faqs={processFaqs} />
    <Action class="questions__action" href="/#questions" variant="line"
      >The rest of the questions</Action
    >
  </Sheet>

  {/* ---- 05 Invitation ----------------------------------------------- */}
  <Invitation
    index="05"
    label="Invitation"
    statement={{ lead: 'Start at', mark: 'step one', tail: '.' }}
    lead="Discovery is a conversation before it is an invoice. The first call is where we work out whether there is a project here at all."
    expectations={[
      'You describe the situation, the constraints and the deadline',
      'We ask the questions that change the recommendation',
      'A written scope and a number follow if it is a fit',
    ]}
  />
</BaseLayout>

<style>
  /* =====================================================================
     03 Working rules — the one loud field on the page
     ===================================================================== */

  .working__mark {
    margin-block-end: var(--space-s);
  }

  .working__label {
    margin-block-end: var(--space-m);
  }

  .working__title {
    max-width: 16ch;
  }

  .working {
    display: grid;
    gap: 0;
    margin: var(--space-2xl) 0 0;
    padding: 0;
    border-block-start: var(--rule-heavy) solid var(--rule-strong);
  }

  .working__item {
    padding-block: var(--space-l);
    border-block-end: var(--rule-hair) solid var(--rule);
  }

  .working__index {
    color: var(--ink-soft);
  }

  .working__name {
    max-width: 20ch;
    margin-block-start: var(--space-s);
    font-size: var(--step-2);
    font-weight: 500;
    line-height: var(--leading-tight);
    letter-spacing: var(--track-heading);
  }

  .working__description {
    max-width: 40ch;
    margin-block-start: var(--space-s);
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--ink-soft);
  }

  @media (min-width: 64rem) {
    .working {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-2xl);
    }

    /* The second column is dropped half a step, so the field reads as a
       staggered list rather than as a two-by-two grid of cards. */
    .working__item:nth-child(even) {
      margin-block-start: var(--space-xl);
      padding-inline-start: var(--space-l);
      border-inline-start: var(--rule-hair) solid var(--rule);
      margin-inline-start: calc(var(--space-l) * -1);
    }
  }

  /* =====================================================================
     04 Questions
     ===================================================================== */

  .questions__action {
    margin-block-start: var(--space-xl);
  }
</style>
