---
/**
 * The header is the sheet's first line, not a utility bar bolted above it:
 * same field edges as every sheet below it, same mono handwriting, same index
 * numbers, same selection colour as the offer index further down the page.
 *
 * It is laid out as one band with three known parts — the wordmark on the
 * page's left edge, the navigation distributed across the middle as equal
 * index cells, and language + booking sitting on the right edge. Nothing
 * floats; every part starts or ends on a field edge.
 *
 * The compact navigation is a native <details> disclosure, so it is keyboard
 * operable and fully functional with zero JavaScript. The script below only
 * adds conveniences (close on Escape, close after following a link).
 */
import LanguageToggle from './LanguageToggle.astro';
import Wordmark from './Wordmark.astro';
import Action from './primitives/Action.astro';
import { integrations, isCurrent, nav } from '../lib/site';

interface Props {
  tone?: 'paper' | 'deep';
}

const { tone = 'paper' } = Astro.props;
const pathname = Astro.url.pathname;
---

<header class:list={['masthead', `tone-${tone}`]}>
  <div class="spread masthead__inner">
    <Wordmark href="/" class="masthead__wordmark" />

    <nav class="masthead__nav" aria-label="Primary">
      <ul class="masthead__list" role="list">
        {
          nav.map((item) => {
            const current = isCurrent(item.href, pathname);
            return (
              <li class="masthead__item">
                <a
                  class="masthead__link"
                  href={item.href}
                  aria-current={current ? 'page' : undefined}
                >
                  <span class="masthead__index" aria-hidden="true">
                    {item.index}
                  </span>
                  <span class="masthead__label">{item.label}</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="masthead__end">
      <LanguageToggle class="masthead__lang" />
      <Action href={integrations.booking.url} class="masthead__cta">Book a call</Action>

      <details class="menu" data-menu>
        <summary class="menu__toggle">
          <span class="menu__toggle-text">Index</span>
          <span class="menu__rules" aria-hidden="true"></span>
        </summary>
        <div class="menu__panel tone-paper">
          <div class="spread menu__panel-inner">
            <nav aria-label="Primary, compact">
              <ul class="menu__list" role="list">
                {
                  nav.map((item) => (
                    <li>
                      <a
                        class="menu__link"
                        href={item.href}
                        aria-current={isCurrent(item.href, pathname) ? 'page' : undefined}
                      >
                        <span class="menu__index" aria-hidden="true">
                          {item.index}
                        </span>
                        <span class="menu__label">{item.label}</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </nav>
            <div class="menu__foot">
              <LanguageToggle />
              <Action href={integrations.booking.url} size="large">Book a call</Action>
            </div>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // Progressive enhancement only: the disclosure already works without this.
  const menu = document.querySelector<HTMLDetailsElement>('[data-menu]');

  if (menu) {
    menu.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      if (target?.closest('.menu__link')) menu.open = false;
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector<HTMLElement>('.menu__toggle')?.focus();
      }
    });
  }
</script>

<style>
  .masthead {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--z-header);
    background-color: var(--field);
    color: var(--ink);
    border-block-end: var(--rule-hair) solid var(--rule-strong);
  }

  .masthead__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    column-gap: var(--space-m);
    min-height: var(--header-height);
  }

  /* The wordmark's registration square is the page's left edge: it sits on the
     gutter, in line with every rule and every first column below it. */
  .masthead__wordmark {
    justify-self: start;
  }

  /* ---- Wide navigation ---- */

  .masthead__nav {
    display: none;
    align-self: stretch;
  }

  .masthead__list {
    display: grid;
    /* Equal cells across the width the nav is given: a navigation system, not
       a cluster pushed against one end of the band. */
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    height: 100%;
    margin: 0;
    padding: 0;
  }

  .masthead__item {
    display: flex;
    /* Hairline verticals turn the nav into a row of index cells — the same
       device the offer index uses further down the page. The block is closed
       at both ends, so no rule is left hanging beside the wordmark. */
    border-inline-start: var(--rule-hair) solid var(--rule);
  }

  .masthead__item:last-child {
    border-inline-end: var(--rule-hair) solid var(--rule);
  }

  .masthead__link {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    gap: var(--space-2xs);
    padding-inline: var(--space-xs);
    font-size: var(--step--1);
    letter-spacing: var(--track-tight);
    text-align: center;
    text-decoration: none;
    color: var(--ink);
    transition: background-color var(--duration-fast) var(--ease);
  }

  .masthead__index {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--track-label);
    color: var(--signal);
  }

  /* Selection is the highlighter, here as everywhere else on the sheet. */
  .masthead__link[aria-current='page'] {
    background-color: var(--select);
    color: var(--on-select);
  }

  .masthead__link[aria-current='page'] .masthead__index {
    color: var(--ink);
  }

  @media (hover: hover) {
    .masthead__link:hover {
      background-color: var(--select);
      color: var(--on-select);
    }

    .masthead__link:hover .masthead__index {
      color: var(--ink);
    }
  }

  /* ---- The right edge ---- */

  .masthead__end {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: var(--space-m);
  }

  .masthead__lang,
  .masthead__cta {
    display: none;
  }

  /* ---- Compact disclosure ---- */

  .menu__toggle {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    min-height: 2.75rem;
    /* Flush with the page's right edge; the padding hangs inward only. */
    padding-inline-start: var(--space-s);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    cursor: pointer;
    list-style: none;
  }

  .menu__toggle::-webkit-details-marker {
    display: none;
  }

  .menu__rules {
    display: block;
    width: 1.25rem;
    height: 0.5rem;
    border-block: var(--rule-hair) solid currentColor;
  }

  .menu[open] .menu__rules {
    height: 0;
    border-block-end-color: transparent;
  }

  .menu__panel {
    position: absolute;
    inset-inline: 0;
    inset-block-start: 100%;
    padding-block: var(--space-s) var(--space-xl);
    background-color: var(--field);
    color: var(--ink);
    border-block-end: var(--rule-heavy) solid var(--rule-strong);
  }

  .menu__list {
    display: grid;
    margin: 0;
    padding: 0;
  }

  .menu__link {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    align-items: baseline;
    column-gap: var(--space-s);
    padding-block: var(--space-s);
    border-block-end: var(--rule-hair) solid var(--rule);
    font-size: var(--step-2);
    font-weight: 500;
    letter-spacing: var(--track-heading);
    text-decoration: none;
  }

  .menu__link[aria-current='page'] {
    background-color: var(--select);
    color: var(--on-select);
  }

  .menu__index {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--track-label);
    color: var(--signal);
  }

  .menu__link[aria-current='page'] .menu__index {
    color: var(--ink);
  }

  .menu__foot {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
    margin-block-start: var(--space-l);
  }

  .menu__foot :global(.action) {
    width: 100%;
  }

  @media (min-width: 64rem) {
    .masthead__inner {
      grid-template-columns: auto minmax(0, 1fr) auto;
      column-gap: var(--space-l);
    }

    .masthead__nav {
      display: block;
    }

    .masthead__lang,
    .masthead__cta {
      display: flex;
    }

    .menu {
      display: none;
    }
  }
</style>
