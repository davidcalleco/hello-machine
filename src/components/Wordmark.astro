---
/**
 * Wordmark: a 3×3 hairline grid with one lit cell — the "quiet machine" motif
 * in its smallest form. The same grid is echoed at large scale in the hero.
 */
interface Props {
  href?: string;
}

const { href } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag class="wordmark" {...href ? { href } : {}}>
  <svg
    class="wordmark__mark"
    viewBox="0 0 24 24"
    width="24"
    height="24"
    aria-hidden="true"
    focusable="false"
  >
    <rect x="0.5" y="0.5" width="23" height="23" fill="none" stroke="currentColor" stroke-width="1"
    ></rect>
    <path
      d="M8.5 0.5v23M15.5 0.5v23M0.5 8.5h23M0.5 15.5h23"
      stroke="currentColor"
      stroke-width="1"
      opacity="0.45"></path>
    <rect class="wordmark__cell" x="8.5" y="8.5" width="7" height="7"></rect>
  </svg>
  <span class="wordmark__text">
    <span class="wordmark__word">Hello</span><span class="wordmark__word wordmark__word--machine"
      >Machine</span
    >
  </span>
</Tag>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    color: var(--on-surface);
    font-family: var(--font-display);
    font-size: var(--step-1);
    letter-spacing: var(--tracking-tight);
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  .wordmark__mark {
    width: 1.35em;
    height: 1.35em;
    flex: none;
  }

  .wordmark__cell {
    fill: var(--accent);
    transition: fill var(--duration-base) var(--ease-out);
  }

  .wordmark__word + .wordmark__word::before {
    content: ' ';
  }

  .wordmark__word--machine {
    font-style: italic;
  }

  @media (hover: hover) {
    a.wordmark:hover .wordmark__cell {
      fill: var(--on-surface);
    }
  }
</style>
