---
/**
 * Wordmark: the studio name set in the sheet's own voice, preceded by a
 * registration square — the smallest version of the marks that appear at
 * scale elsewhere on the field.
 *
 * The square carries the action colour: it is the one piece of the chrome
 * that is allowed to be loud.
 */
interface Props {
  href?: string;
  size?: 'default' | 'large';
  class?: string;
}

const { href, size = 'default', class: className } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag class:list={['wordmark', `wordmark--${size}`, className]} {...href ? { href } : {}}>
  <span class="wordmark__square" aria-hidden="true"></span>
  <span class="wordmark__text">Hello Machine</span>
</Tag>

<style>
  .wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5em;
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: var(--step-0);
    font-weight: 500;
    letter-spacing: var(--track-tight);
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  .wordmark--large {
    font-size: var(--step-2);
  }

  .wordmark__square {
    flex: none;
    width: 0.62em;
    height: 0.62em;
    background-color: var(--action);
    transition: background-color var(--duration-base) var(--ease);
  }

  @media (hover: hover) {
    a.wordmark:hover .wordmark__square {
      background-color: var(--signal);
    }
  }
</style>
