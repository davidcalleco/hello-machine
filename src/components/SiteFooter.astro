---
/**
 * The colophon at the foot of the sheet.
 *
 * Set on the ink field: the page closes on the one surface that is not paper,
 * which is what makes it read as the end rather than as another section.
 *
 * Anything still waiting on David is stated plainly as pending rather than
 * dressed up as finished. See CONTENT-DEPENDENCIES in the data modules.
 */
import LanguageToggle from './LanguageToggle.astro';
import Wordmark from './Wordmark.astro';
import { practices } from '../data/services';
import { integrations, isCurrent, nav, site } from '../lib/site';

const year = new Date().getFullYear();
const pathname = Astro.url.pathname;
---

<footer class="colophon tone-ink">
  <div class="spread colophon__inner">
    <div class="colophon__brand">
      <Wordmark size="large" />
      <p class="colophon__tagline">{site.tagline}</p>
      <p class="colophon__note">
        Independent studio. Engagements are founder-led, in English or Español.
      </p>
    </div>

    <nav class="colophon__group" aria-label="Site">
      <h2 class="label colophon__heading">Index</h2>
      <ul class="colophon__list" role="list">
        {
          nav.map((item) => (
            <li>
              <a
                class="colophon__link"
                href={item.href}
                aria-current={isCurrent(item.href, pathname) ? 'page' : undefined}
              >
                <span class="colophon__index" aria-hidden="true">
                  {item.index}
                </span>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav class="colophon__group" aria-label="Practices">
      <h2 class="label colophon__heading">Practices</h2>
      <ul class="colophon__list" role="list">
        {
          practices.map((practice) => (
            <li>
              <a class="colophon__link" href={`/services/${practice.slug}/`}>
                <span class="colophon__index" aria-hidden="true">
                  {practice.index}
                </span>
                {practice.shortName}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="colophon__group">
      <h2 class="label colophon__heading">Contact</h2>
      <ul class="colophon__list" role="list">
        <li>
          <a class="colophon__link" href={integrations.booking.url}>Book a call</a>
        </li>
        <li>
          <a class="colophon__link" href={`mailto:${integrations.contact.email}`}>
            {integrations.contact.email}
          </a>
        </li>
      </ul>
      <LanguageToggle class="colophon__lang" />
      <p class="colophon__pending">
        Registered company details and postal address to be added before launch.
      </p>
    </div>
  </div>

  <div class="spread colophon__legal">
    <p>© {year} {site.name}</p>
    <ul class="colophon__legal-list" role="list">
      <li><a class="colophon__link" href="/privacy/">Privacy</a></li>
      <li>
        <span class="colophon__pending colophon__pending--inline">Terms — in preparation</span>
      </li>
    </ul>
  </div>
</footer>

<style>
  .colophon {
    background-color: var(--field);
    color: var(--ink);
    /* The invitation sheet above is also set on ink, so the colophon draws its
       own top edge — without it the page's close and its colophon merge into
       one undifferentiated block. */
    border-block-start: var(--rule-hair) solid var(--rule);
    padding-block-start: var(--sheet-space);
    padding-block-end: var(--space-l);
  }

  .colophon__inner {
    display: grid;
    gap: var(--space-2xl);
  }

  .colophon__tagline {
    max-width: 18ch;
    margin-block-start: var(--space-m);
    font-size: var(--step-3);
    font-weight: 500;
    line-height: var(--leading-tight);
    letter-spacing: var(--track-heading);
    text-wrap: balance;
  }

  .colophon__note {
    max-width: 34ch;
    margin-block-start: var(--space-m);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .colophon__heading {
    padding-block-end: var(--space-2xs);
    margin-block-end: var(--space-2xs);
    border-block-end: var(--rule-hair) solid var(--rule);
    color: var(--ink-soft);
  }

  .colophon__list {
    display: grid;
    margin: 0;
    padding: 0;
  }

  .colophon__link {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2xs);
    min-height: 2.5rem;
    padding-block: var(--space-3xs);
    font-size: var(--step--1);
    text-decoration: none;
    color: var(--ink);
    transition: color var(--duration-fast) var(--ease);
  }

  .colophon__index {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--track-label);
    color: var(--signal);
  }

  .colophon__link[aria-current='page'] {
    color: var(--signal);
  }

  @media (hover: hover) {
    .colophon__link:hover {
      color: var(--signal);
      text-decoration: underline;
    }
  }

  .colophon__lang {
    margin-block-start: var(--space-s);
  }

  .colophon__pending {
    display: block;
    max-width: 28ch;
    margin-block-start: var(--space-s);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .colophon__pending--inline {
    margin: 0;
  }

  .colophon__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    margin-block-start: var(--space-2xl);
    padding-block-start: var(--space-m);
    border-block-start: var(--rule-hair) solid var(--rule);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .colophon__legal-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m);
    margin: 0;
    padding: 0;
  }

  .colophon__legal .colophon__link {
    min-height: 0;
    font-family: inherit;
    font-size: inherit;
    letter-spacing: inherit;
  }

  @media (min-width: 40rem) {
    .colophon__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-xl) var(--space-l);
    }
  }

  @media (min-width: 64rem) {
    .colophon__inner {
      grid-template-columns: 2.2fr repeat(3, minmax(0, 1fr));
      gap: var(--space-l);
    }
  }
</style>
