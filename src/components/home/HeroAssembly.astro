---
import Action from '../primitives/Action.astro';
import { integrations } from '../../lib/site';
---

<section class="v2-hero" id="position" aria-labelledby="hero-title">
  <div class="v2-hero__copy">
    <p class="eyebrow">Hello Machine / independent studio</p>
    <h1 id="hero-title">Expert-led websites,<br /><em>accelerated by AI.</em></h1>
    <p class="v2-hero__lead">People own the thinking. Machines increase the range and speed.</p>
    <div class="v2-hero__actions">
      <Action href={integrations.booking.url} size="large">Book a call</Action><a
        class="text-link"
        href="#work">Explore the work <span aria-hidden="true">↓</span></a
      >
    </div>
  </div>
  <div class="assembly" aria-label="A website assembling from brief to live experience">
    <div class="assembly__top"><span>brief.txt</span><span>01 / 03</span></div>
    <div class="assembly__brief">
      <span class="assembly__cursor" aria-hidden="true">→</span><strong
        >Make the complex clear.</strong
      ><span>for the people who need to act</span>
    </div>
    <div class="assembly__stack">
      <div class="assembly__block assembly__block--signal">
        <span>structure</span><b>who / why / next</b>
      </div><div class="assembly__block assembly__block--edit">
        <span>edit</span><b>remove the noise</b>
      </div><div class="assembly__block assembly__block--live">
        <span>live</span><b>hello-machine.com</b>
      </div>
    </div>
    <p class="assembly__caption">brief → structure → live</p>
  </div>
</section>
<style>
  .v2-hero {
    display: grid;
    gap: var(--space-2xl);
    padding: clamp(4rem, 10vw, 9rem) var(--gutter) clamp(5rem, 12vw, 11rem);
    max-width: var(--width-field);
    margin: auto;
    background: var(--hm-paper);
    color: var(--hm-ink);
  }
  .v2-hero__copy {
    max-width: 58rem;
  }
  .eyebrow,
  .assembly__top,
  .assembly__caption {
    font: var(--step--2)/1.2 var(--font-mono);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
  }
  .v2-hero h1 {
    max-width: 12ch;
    margin: var(--space-m) 0;
    font-size: clamp(3.2rem, 8vw, 8.5rem);
    font-weight: 500;
    line-height: 0.88;
    letter-spacing: var(--track-display);
  }
  .v2-hero h1 em {
    font-family: var(--font-serif);
    font-weight: 400;
    color: var(--hm-red);
  }
  .v2-hero__lead {
    max-width: 30ch;
    font-size: var(--step-1);
    line-height: 1.3;
    color: var(--hm-ink-soft);
  }
  .v2-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-l);
    margin-top: var(--space-xl);
  }
  .text-link {
    font: var(--step--2)/1.2 var(--font-mono);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 0.35em;
  }
  .assembly {
    min-height: 27rem;
    padding: var(--space-m);
    background: var(--hm-ink);
    color: var(--hm-paper);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .assembly__top {
    display: flex;
    justify-content: space-between;
    color: var(--hm-lime);
  }
  .assembly__brief {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-2xs);
    align-items: baseline;
    max-width: 25ch;
    font-size: var(--step-2);
    line-height: 1;
  }
  .assembly__brief span:last-child {
    grid-column: 2;
    font: var(--step--1)/1.3 var(--font-mono);
    color: #aaa;
  }
  .assembly__cursor {
    color: var(--hm-orange);
  }
  .assembly__stack {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2xs);
    align-items: end;
  }
  .assembly__block {
    min-height: 6rem;
    padding: var(--space-xs);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    color: var(--hm-ink);
  }
  .assembly__block span {
    font: var(--step--2) var(--font-mono);
    text-transform: uppercase;
  }
  .assembly__block b {
    font-size: var(--step--1);
    line-height: 1.05;
  }
  .assembly__block--signal {
    min-height: 9rem;
    background: var(--hm-blue);
  }
  .assembly__block--edit {
    min-height: 12rem;
    background: var(--hm-red);
  }
  .assembly__block--live {
    min-height: 15rem;
    background: var(--hm-lime);
  }
  .assembly__caption {
    color: #aaa;
  }
  @media (min-width: 55rem) {
    .v2-hero {
      grid-template-columns: minmax(0, 1.1fr) minmax(20rem, 0.7fr);
      align-items: end;
    }
    .assembly {
      transform: rotate(2deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .assembly {
      transform: none;
    }
  }
</style>
