---
import { homeSteps } from '../../data/home-v2';
---

<section class="process-scene" id="process" aria-labelledby="process-title">
  <div class="process-scene__heading">
    <p class="eyebrow">02 / method</p><h2 id="process-title">
      A clear route<br /><em>through the fog.</em>
    </h2>
  </div><div class="pipeline" data-pipeline>
    <div class="pipeline__artifact" data-artifact><span>01</span><strong>brief</strong></div><div
      class="pipeline__steps"
      role="tablist"
      aria-label="Process steps"
    >
      {
        homeSteps.map((step, i) => (
          <button
            class:list={['pipeline__step', i === 0 && 'is-active']}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`step-${step.id}`}
            data-step={step.id}
          >
            <span>{step.number}</span>
            {step.title}
          </button>
        ))
      }
    </div><div class="pipeline__copy">
      {
        homeSteps.map((step, i) => (
          <p id={`step-${step.id}`} class:list={[i !== 0 && 'is-hidden']} role="tabpanel">
            {step.text}
          </p>
        ))
      }
    </div>
  </div>
</section>
<script>
  const pipeline = document.querySelector('[data-pipeline]');
  if (pipeline) {
    const artifact = pipeline.querySelector('[data-artifact]');
    const buttons = Array.from(pipeline.querySelectorAll<HTMLButtonElement>('[data-step]'));
    buttons.forEach((button, index) =>
      button.addEventListener('click', () => {
        pipeline.querySelector('.is-active')?.classList.remove('is-active');
        button.classList.add('is-active');
        pipeline
          .querySelectorAll('[role=tab]')
          .forEach((tab) => tab.setAttribute('aria-selected', tab === button ? 'true' : 'false'));
        pipeline
          .querySelectorAll('[role=tabpanel]')
          .forEach((panel, panelIndex) =>
            panel.classList.toggle('is-hidden', panelIndex !== index),
          );
        artifact?.querySelector('span')?.replaceChildren(String(index + 1).padStart(2, '0'));
        artifact
          ?.querySelector('strong')
          ?.replaceChildren(['brief', 'structure', 'interface', 'system'][index]);
      }),
    );
    buttons.forEach((button, index) =>
      button.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
        event.preventDefault();
        buttons[
          (index + (event.key === 'ArrowDown' ? 1 : -1) + buttons.length) % buttons.length
        ]?.focus();
      }),
    );
  }
</script>
<style>
  .process-scene {
    padding: clamp(5rem, 12vw, 11rem) var(--gutter);
    background: var(--hm-blue);
    color: var(--hm-paper);
  }
  .process-scene__heading {
    max-width: 70rem;
    margin: auto;
  }
  .process-scene h2 {
    margin: var(--space-m) 0 0;
    font-size: clamp(3rem, 8vw, 8rem);
    line-height: 0.86;
    letter-spacing: var(--track-display);
  }
  .process-scene h2 em {
    font-family: var(--font-serif);
    font-weight: 400;
    color: var(--hm-lime);
  }
  .pipeline {
    display: grid;
    gap: var(--space-xl);
    max-width: 90rem;
    margin: clamp(4rem, 9vw, 8rem) auto 0;
  }
  .pipeline__artifact {
    display: flex;
    aspect-ratio: 1/1;
    max-width: 22rem;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-m);
    background: var(--hm-lime);
    color: var(--hm-ink);
    font: var(--step--2) var(--font-mono);
    text-transform: uppercase;
  }
  .pipeline__artifact strong {
    font: clamp(3rem, 7vw, 6rem)/0.8 var(--font-sans);
    letter-spacing: var(--track-display);
    text-transform: lowercase;
  }
  .pipeline__steps {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: rgb(255 255 255 / 0.35);
  }
  .pipeline__step {
    min-height: 5rem;
    padding: var(--space-s);
    border: 0;
    background: var(--hm-blue);
    color: var(--hm-paper);
    font: var(--step-1) var(--font-sans);
    text-align: left;
    cursor: pointer;
  }
  .pipeline__step span {
    display: block;
    margin-bottom: var(--space-xs);
    font: var(--step--2) var(--font-mono);
    color: var(--hm-lime);
  }
  .pipeline__step.is-active,
  .pipeline__step:hover {
    background: var(--hm-ink);
  }
  .pipeline__copy {
    max-width: 32ch;
    font-size: var(--step-1);
    line-height: 1.25;
  }
  .is-hidden {
    display: none;
  }
  @media (min-width: 55rem) {
    .pipeline {
      grid-template-columns: 0.8fr 1.1fr 0.7fr;
      align-items: end;
    }
    .pipeline__steps {
      grid-template-columns: 1fr;
    }
    .pipeline__step {
      min-height: 4.5rem;
    }
  }
</style>
