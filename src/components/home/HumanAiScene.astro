<section class="human-scene" id="judgment" aria-labelledby="human-title">
  <div class="human-scene__head">
    <p class="eyebrow">04 / trust the split</p><h2 id="human-title">
      AI brings the speed.<br /><em>People hold the line.</em>
    </h2>
  </div><div class="split-meter" data-split>
    <div class="split-meter__machine">
      <span>machine / accelerates</span><strong>draft<br />sort<br />repeat</strong>
    </div><div class="split-meter__human">
      <span>human / owns</span><strong>decide<br />edit<br />answer</strong>
    </div><label class="split-meter__control"
      >Adjust the balance<input
        type="range"
        min="20"
        max="80"
        value="50"
        aria-label="Adjust the balance between machine and human work"
      /></label
    >
  </div>
</section>
<script>
  const split = document.querySelector<HTMLElement>('[data-split]');
  const balance = split?.querySelector<HTMLInputElement>('input');
  balance?.addEventListener('input', () => {
    split?.style.setProperty('--machine-width', `${balance.value}%`);
  });
</script>
