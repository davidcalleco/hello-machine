---
/**
 * 03 The division of labour — the one loud field on the page.
 *
 * Two columns because the content is a comparison: what the machine runs, and
 * what people run. The lists carry no rules of their own; the two headed
 * columns are the grouping, and adding a hairline under every line item would
 * only fill the field with noise. The closing assurance sits in the right-hand
 * columns, under the column it answers — not at an arbitrary half-width
 * indent.
 */
import Sheet from '../Sheet.astro';
import Label from '../primitives/Label.astro';
import Statement from '../primitives/Statement.astro';
import { judgment } from '../../data/home';
---

<Sheet id="judgment" tone="signal" size="open" labelledby="judgment-title">
  <div class="division field-grid">
    <div class="division__head">
      <Label class="division__label" index={judgment.index} text={judgment.label} tone="ink" />
      <Statement
        statement={judgment.statement}
        as="h2"
        size={2}
        tone="editorial"
        id="judgment-title"
      />
    </div>

    <p class="division__lead">{judgment.lead}</p>

    {
      judgment.columns.map((column) => (
        <section class="division__column" aria-labelledby={`judgment-${column.key}`}>
          <p class="label division__column-label">{column.label}</p>
          <h3 class="division__column-title" id={`judgment-${column.key}`}>
            {column.title}
          </h3>
          <ul class="division__list" role="list">
            {column.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      ))
    }

    <p class="division__assurance">{judgment.assurance}</p>
  </div>
</Sheet>

<style>
  .division {
    --field-row-gap: var(--space-2xl);
  }

  .division__label {
    margin-block-end: var(--space-m);
  }

  .division__lead {
    max-width: 44ch;
    font-size: var(--step-0);
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .division__column {
    padding-block-start: var(--space-s);
    border-block-start: var(--rule-heavy) solid var(--rule-strong);
  }

  .division__column-label {
    color: var(--ink-soft);
  }

  .division__column-title {
    max-width: 24ch;
    margin-block-start: var(--space-2xs);
    font-size: var(--step-2);
    font-weight: 500;
    line-height: var(--leading-tight);
    letter-spacing: var(--track-heading);
    text-wrap: balance;
  }

  .division__list {
    display: grid;
    gap: var(--space-xs);
    margin: var(--space-l) 0 0;
    padding: 0;
    max-width: 42ch;
  }

  .division__list > li {
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr);
    gap: var(--space-2xs);
    font-size: var(--step--1);
    line-height: 1.4;
  }

  .division__list > li::before {
    content: '+';
    font-family: var(--font-mono);
    color: var(--signal);
  }

  .division__assurance {
    max-width: 40ch;
    padding-inline-start: var(--space-m);
    border-inline-start: var(--rule-heavy) solid var(--editorial);
    font-size: var(--step-1);
    line-height: 1.3;
    letter-spacing: var(--track-tight);
    text-wrap: pretty;
  }

  @media (min-width: 64rem) {
    .division__head {
      grid-column: 1 / span 6;
      grid-row: 1;
    }

    .division__lead {
      grid-column: 7 / -1;
      grid-row: 1;
      /* Optically level with the statement's first line. */
      padding-block-start: 0.4em;
    }

    .division__column:nth-of-type(1) {
      grid-column: 1 / span 6;
      grid-row: 2;
    }

    .division__column:nth-of-type(2) {
      grid-column: 7 / -1;
      grid-row: 2;
    }

    .division__assurance {
      grid-column: 7 / -1;
      grid-row: 3;
    }
  }
</style>
