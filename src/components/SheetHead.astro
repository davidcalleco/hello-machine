---
/**
 * The opening of a sheet: index, label, statement, and an optional note.
 *
 * One alignment, everywhere: the label and the statement start on column 1 of
 * the field grid, flush with the page edge and with the content below. The
 * only asymmetry is earned — when a section supplies a note, it takes the last
 * three columns, so the right of the page is occupied by something to read
 * rather than by a heading pushed into empty space.
 *
 *   split   note in the right columns, beside the statement (default)
 *   stack   note directly under the statement, in the text column
 *
 * `offset` is kept as an alias of `split` so existing pages keep working.
 */
import Label from './primitives/Label.astro';
import Statement from './primitives/Statement.astro';
import type { StatementText } from './primitives/Statement.astro';

interface Props {
  index?: string;
  label: string;
  statement: StatementText;
  /** Heading id, so the parent sheet can be labelled by it. */
  id: string;
  as?: 'h2' | 'h3';
  size?: 1 | 2 | 3;
  tone?: 'editorial' | 'signal';
  lead?: string;
  note?: string;
  layout?: 'split' | 'stack' | 'offset';
  class?: string;
}

const {
  index,
  label,
  statement,
  id,
  as = 'h2',
  size = 3,
  tone = 'editorial',
  lead,
  note,
  layout = 'split',
  class: className,
} = Astro.props;

const placement = layout === 'stack' ? 'stack' : 'split';
---

<header
  class:list={[
    'sheet-head',
    'field-grid',
    `sheet-head--${placement}`,
    { 'sheet-head--noted': Boolean(note) },
    className,
  ]}
>
  <div class="sheet-head__body">
    <Label class="sheet-head__label" index={index} text={label} tone="ink" />
    <Statement statement={statement} as={as} size={size} tone={tone} id={id} />
    {lead && <p class="lead sheet-head__lead">{lead}</p>}
  </div>

  {note && <p class="note sheet-head__note">{note}</p>}
</header>

<style>
  .sheet-head {
    /* The section divider. The one rule at the top of a sheet — the content
       block below brings its own, and the two are a full step apart. */
    border-block-start: var(--rule-heavy) solid var(--rule-strong);
    padding-block-start: var(--space-s);
    margin-block-end: var(--space-2xl);
    --field-row-gap: var(--space-l);
  }

  .sheet-head__label {
    margin-block-end: var(--space-m);
  }

  .sheet-head__lead {
    margin-block-start: var(--space-m);
    max-width: 46ch;
    color: var(--ink-soft);
  }

  @media (min-width: 60rem) {
    .sheet-head__body {
      grid-column: 1 / span 8;
    }

    .sheet-head--noted .sheet-head__body {
      grid-column: 1 / span 7;
    }

    .sheet-head--split.sheet-head--noted .sheet-head__note {
      grid-column: 9 / -1;
      /* Optical alignment with the statement's first baseline rather than
         with the top of its line box. */
      padding-block-start: 0.45em;
    }

    .sheet-head--stack .sheet-head__body,
    .sheet-head--stack .sheet-head__note {
      grid-column: 1 / span 8;
    }
  }
</style>
