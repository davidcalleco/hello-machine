---
/**
 * A sheet: one section of the field.
 *
 * Owns three things only — the tone (colour field), the vertical rhythm, and
 * the rule that separates it from the sheet above. It deliberately does NOT
 * impose an internal layout, because the approved direction requires every
 * section to earn its own composition. Shared primitives enforce alignment
 * and accessibility; they do not enforce sameness.
 */
interface Props {
  id?: string;
  tone?: 'paper' | 'deep' | 'signal' | 'ink';
  /** Vertical breathing room. Quiet sheets get more. */
  size?: 'tight' | 'default' | 'open';
  /** The separating rule at the top of the sheet. */
  rule?: 'none' | 'hair' | 'heavy';
  labelledby?: string;
  /** Renders content edge to edge instead of inside the field width. */
  bleed?: boolean;
  as?: 'section' | 'div';
  class?: string;
}

const {
  id,
  tone = 'paper',
  size = 'default',
  rule = 'none',
  labelledby,
  bleed = false,
  as: Tag = 'section',
  class: className,
} = Astro.props;
---

<Tag
  id={id}
  class:list={['sheet', `tone-${tone}`, `sheet--${size}`, `sheet--rule-${rule}`, className]}
  aria-labelledby={labelledby}
>
  {
    bleed ? (
      <slot />
    ) : (
      <div class="spread sheet__spread">
        <slot />
      </div>
    )
  }
</Tag>

<style>
  .sheet {
    position: relative;
    background-color: var(--field);
    color: var(--ink);
    padding-block: var(--sheet-space);
  }

  .sheet--tight {
    padding-block: var(--sheet-space-tight);
  }

  .sheet--open {
    padding-block: var(--sheet-space-open);
  }

  /* The rule sits inside the field width so it aligns with the content grid
     rather than running off to the browser edge. */
  .sheet--rule-hair::before,
  .sheet--rule-heavy::before {
    content: '';
    position: absolute;
    inset-block-start: 0;
    inset-inline: var(--gutter);
    max-width: var(--width-field);
    margin-inline: auto;
    background-color: var(--rule-strong);
  }

  .sheet--rule-hair::before {
    height: var(--rule-hair);
    background-color: var(--rule);
  }

  .sheet--rule-heavy::before {
    height: var(--rule-heavy);
  }

  .sheet__spread {
    position: relative;
  }
</style>
