---
/**
 * The opening statement of a sheet.
 *
 * A statement is stored as three parts so the serif editing mark always lands
 * on the phrase a person would have underlined — never on a random word, and
 * never guessed at render time. That mark is the site's recurring gesture:
 * Instrument Serif italic in the editorial (red) or signal (blue) colour,
 * dropped into a Space Grotesk line.
 */
import type { HTMLTag } from 'astro/types';

export interface StatementText {
  lead: string;
  mark: string;
  tail?: string;
}

interface Props {
  statement: StatementText;
  as?: HTMLTag;
  /** 1 is the page's loudest line; 3 opens a section. */
  size?: 1 | 2 | 3;
  tone?: 'editorial' | 'signal';
  id?: string;
  class?: string;
}

const {
  statement,
  as: Tag = 'h2',
  size = 3,
  tone = 'editorial',
  id,
  class: className,
} = Astro.props;
---

<Tag id={id} class:list={[`display-${size}`, 'statement', className]}
  >{statement.lead}{' '}<em class:list={['mark-serif', `mark-serif--${tone}`]}>{statement.mark}</em
  >{statement.tail}</Tag
>

<style>
  .statement {
    /* Statements are cropped tight on purpose; the descenders of the serif
       italic would otherwise be clipped by the line box above. */
    padding-block-end: 0.06em;
    /* Display type breaks badly when it is allowed to run the full width of
       the field: a long first line and then one orphaned word. A measure per
       size — tighter the larger the type — plus balanced wrapping gives every
       statement two or three even lines instead. Sections that need a
       different measure set --statement-measure; nothing is ever clipped. */
    max-width: var(--statement-measure, 24ch);
    text-wrap: balance;
  }

  .display-1 {
    --statement-measure: 11ch;
  }

  .display-2 {
    --statement-measure: 14ch;
  }

  .display-3 {
    --statement-measure: 18ch;
  }
</style>
