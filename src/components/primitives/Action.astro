---
/**
 * The action primitive. Renders <a> with `href`, otherwise <button>.
 *
 * Colours come from the surrounding tone's `--action` / `--on-action` roles,
 * so the same variant reads correctly on paper, on the signal field and on
 * ink without per-section overrides.
 *
 * External URLs are detected from the href, which matters because the booking
 * CTA points at an on-page section today and will point at a scheduler domain
 * once one is configured (see src/lib/site.ts).
 */
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'a'>, 'type'> {
  href?: string;
  /** block — filled action mark. line — underlined inline route. ghost — outlined. */
  variant?: 'block' | 'line' | 'ghost';
  size?: 'default' | 'large';
  type?: 'button' | 'submit';
}

const {
  href,
  variant = 'block',
  size = 'default',
  type = 'button',
  class: className,
  ...rest
} = Astro.props;

const isExternal = Boolean(href && /^(https?:)?\/\//.test(href));
const Tag = href ? 'a' : 'button';
---

<Tag
  class:list={['action', `action--${variant}`, `action--${size}`, className]}
  {...href ? { href } : { type }}
  {...isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
  {...rest}
>
  <span class="action__label"><slot /></span>
  <span class="action__arrow" aria-hidden="true">↗</span>
  {isExternal && <span class="visually-hidden">(opens in a new tab)</span>}
</Tag>

<style>
  .action {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    /* 48px minimum target, comfortably above the 44px guideline. */
    min-height: 3rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 400;
    letter-spacing: var(--track-label);
    line-height: 1.2;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    /* Sharp corners everywhere: this is a printed mark on a sheet, not a pill. */
    border-radius: 0;
    transition:
      background-color var(--duration-base) var(--ease),
      color var(--duration-base) var(--ease),
      border-color var(--duration-base) var(--ease);
  }

  .action__arrow {
    font-size: 1.25em;
    line-height: 1;
    transition: transform var(--duration-base) var(--ease);
  }

  /* ---- block: the primary action mark ---- */

  .action--block {
    padding: var(--space-s) var(--space-m);
    background-color: var(--action);
    color: var(--on-action);
    border: var(--rule-hair) solid var(--action);
  }

  .action--large {
    min-height: 3.5rem;
    padding: var(--space-m) var(--space-l);
    font-size: var(--step--1);
  }

  /* ---- ghost: secondary, same footprint ---- */

  .action--ghost {
    padding: var(--space-s) var(--space-m);
    background-color: transparent;
    color: var(--ink);
    border: var(--rule-hair) solid var(--rule-strong);
  }

  /* ---- line: an inline route, not a button ---- */

  .action--line {
    gap: var(--space-2xs);
    padding-block: var(--space-3xs);
    background: none;
    border: 0;
    color: var(--ink);
    border-block-end: var(--rule-hair) solid var(--rule-strong);
  }

  @media (hover: hover) {
    .action--block:hover {
      background-color: var(--ink);
      color: var(--field);
      border-color: var(--ink);
    }

    .action--ghost:hover {
      background-color: var(--ink);
      color: var(--field);
    }

    .action--line:hover {
      border-block-end-color: var(--action);
      color: var(--action);
    }

    .action:hover .action__arrow {
      transform: translate(0.15em, -0.15em);
    }
  }

  /* On the signal and ink fields the action is already a light mark, so the
     hover inversion uses paper rather than the field colour. */
  :global(.tone-signal) .action--ghost,
  :global(.tone-ink) .action--ghost {
    color: var(--ink);
    border-color: var(--rule-strong);
  }

  /* Full-width on the narrowest screens so two actions never crowd. */
  @media (max-width: 30rem) {
    .action--block,
    .action--ghost {
      width: 100%;
    }
  }
</style>
