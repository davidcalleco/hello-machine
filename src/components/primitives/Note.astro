---
/**
 * A note pinned in the margin of the sheet: a rule, a mono caption, and a
 * short piece of prose in the studio's own voice. This is the annotation
 * device the Field Sheet direction is built on — it carries the aside that a
 * generic site would have set as a paragraph nobody reads.
 */
interface Props {
  label?: string;
  /** side — a vertical rule to the left. top — a rule above. */
  rule?: 'side' | 'top';
  size?: 'default' | 'large';
  class?: string;
}

const { label, rule = 'side', size = 'default', class: className } = Astro.props;
---

<aside class:list={['note-block', `note-block--${rule}`, `note-block--${size}`, className]}>
  {label && <p class="label note-block__label">{label}</p>}
  <p class="note-block__body"><slot /></p>
</aside>

<style>
  .note-block {
    max-width: var(--width-note);
    color: var(--ink);
  }

  .note-block--side {
    border-inline-start: var(--rule-hair) solid var(--rule-strong);
    padding-inline-start: var(--space-m);
  }

  .note-block--top {
    border-block-start: var(--rule-hair) solid var(--rule-strong);
    padding-block-start: var(--space-xs);
  }

  .note-block__label {
    margin-block-end: var(--space-m);
    color: var(--ink-soft);
  }

  .note-block__body {
    font-size: var(--step-0);
    line-height: 1.32;
    letter-spacing: var(--track-tight);
  }

  .note-block--large {
    max-width: 26rem;
  }

  .note-block--large .note-block__body {
    font-size: var(--step-1);
    line-height: 1.24;
  }
</style>
