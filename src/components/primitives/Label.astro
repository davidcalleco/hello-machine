---
/**
 * The sheet's handwriting: a mono, uppercase label, optionally prefixed with
 * its index number. Used for section markers, column headings, coordinates
 * and anywhere the sheet annotates itself.
 */
import type { HTMLTag } from 'astro/types';

interface Props {
  as?: HTMLTag;
  /** Index number, rendered in the signal colour. */
  index?: string;
  text?: string;
  tone?: 'muted' | 'ink' | 'signal';
  /** Draws the short rule that ties the label to the grid. */
  rule?: boolean;
  id?: string;
  class?: string;
}

const {
  as: Tag = 'p',
  index,
  text,
  tone = 'muted',
  rule = false,
  id,
  class: className,
} = Astro.props;
---

<Tag
  id={id}
  class:list={['label', 'field-label', { 'field-label--rule': rule }, className]}
  data-tone={tone}
>
  {rule && <span class="field-label__rule" aria-hidden="true" />}
  {index && <span class="field-label__index">{index}</span>}
  {text ? <span class="field-label__text">{text}</span> : <slot />}
</Tag>

<style>
  .field-label {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  .field-label[data-tone='ink'] {
    color: var(--ink);
  }

  .field-label[data-tone='signal'] {
    color: var(--signal);
  }

  .field-label__index {
    color: var(--signal);
    font-weight: 500;
  }

  .field-label__rule {
    width: var(--space-l);
    height: var(--rule-hair);
    flex: none;
    background-color: var(--editorial);
  }
</style>
