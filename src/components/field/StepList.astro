---
/**
 * The process, as an ordered list — because it is one, and the order is the
 * content.
 *
 *   compact   five columns of number + name + intent, for the homepage strip
 *   full      one entry per step with outputs and its named owner, for the
 *             process page
 *
 * The owner line is not decoration: the whole positioning rests on a person
 * being answerable at every step, so it is given the editorial rule.
 */
import type { ProcessStep } from '../../data/types';

interface Props {
  steps: readonly ProcessStep[];
  variant?: 'compact' | 'full';
  class?: string;
}

const { steps, variant = 'compact', class: className } = Astro.props;
---

<ol class:list={['steps', `steps--${variant}`, className]} role="list">
  {
    steps.map((step) => (
      <li class="steps__step">
        <p class="label steps__index">{step.index}</p>
        <h3 class="steps__name">{step.name}</h3>
        <p class="steps__intent">{step.intent}</p>

        {variant === 'full' && (
          <div class="steps__detail">
            <p class="steps__description">{step.description}</p>

            <div class="steps__outputs">
              <p class="label steps__outputs-label">What you get</p>
              <ul role="list">
                {step.outputs.map((output) => (
                  <li>{output}</li>
                ))}
              </ul>
            </div>

            <p class="steps__owner">
              <span class="label steps__owner-label">Who is answerable</span>
              {step.owner}
            </p>
          </div>
        )}
      </li>
    ))
  }
</ol>

<style>
  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-start: var(--rule-heavy) solid var(--rule-strong);
  }

  .steps__step {
    padding-block: var(--space-m);
    border-block-end: var(--rule-hair) solid var(--rule);
  }

  .steps__index {
    color: var(--signal);
  }

  .steps__name {
    margin-block-start: var(--space-2xs);
    font-size: var(--step-2);
    font-weight: 500;
    line-height: var(--leading-tight);
    letter-spacing: var(--track-heading);
  }

  .steps__intent {
    margin-block-start: var(--space-3xs);
    font-size: var(--step--1);
    line-height: 1.35;
    color: var(--ink-soft);
  }

  /* ---- compact: the strip ---- */

  @media (min-width: 46rem) {
    .steps--compact {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    }

    .steps--compact .steps__step {
      padding-inline-end: var(--space-m);
      border-block-end: 0;
    }

    .steps--compact .steps__step + .steps__step {
      padding-inline-start: var(--space-m);
      border-inline-start: var(--rule-hair) solid var(--rule);
    }
  }

  /* ---- full: the entries ---- */

  .steps--full .steps__step {
    padding-block: var(--space-xl);
  }

  .steps--full .steps__name {
    font-size: var(--step-4);
    line-height: var(--leading-display);
    letter-spacing: var(--track-display);
  }

  .steps--full .steps__intent {
    font-size: var(--step-1);
    letter-spacing: var(--track-tight);
    color: var(--ink);
  }

  .steps__detail {
    display: grid;
    gap: var(--space-l);
    margin-block-start: var(--space-l);
  }

  .steps__description {
    max-width: var(--measure);
    color: var(--ink-soft);
  }

  .steps__outputs ul {
    display: grid;
    gap: var(--space-2xs);
    margin: var(--space-2xs) 0 0;
    padding: 0;
    list-style: none;
  }

  .steps__outputs li {
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr);
    gap: var(--space-2xs);
    font-size: var(--step--1);
    line-height: 1.4;
  }

  .steps__outputs li::before {
    content: '+';
    font-family: var(--font-mono);
    color: var(--signal);
  }

  .steps__owner {
    max-width: 38ch;
    padding-inline-start: var(--space-m);
    border-inline-start: var(--rule-heavy) solid var(--editorial);
    font-size: var(--step--1);
    line-height: 1.4;
  }

  .steps__owner-label,
  .steps__outputs-label {
    display: block;
    margin-block-end: var(--space-3xs);
  }

  @media (min-width: 60rem) {
    .steps--full .steps__step {
      display: grid;
      grid-template-columns: 4.5rem minmax(0, 1fr) minmax(0, 1.1fr);
      column-gap: var(--space-2xl);
      align-items: start;
    }

    .steps--full .steps__index {
      grid-row: 1 / 4;
      padding-block-start: 0.6em;
    }

    .steps--full .steps__intent {
      grid-column: 2;
    }

    .steps--full .steps__detail {
      grid-column: 3;
      grid-row: 1 / 4;
      margin-block-start: 0;
    }
  }
</style>
