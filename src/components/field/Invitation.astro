---
/**
 * The closing sheet: the one structure that is meant to repeat.
 *
 * Every route ends on the same conversion moment in the same place, because
 * that is what makes it findable — but the statement and the supporting copy
 * are supplied per page, so it is never the same words twice.
 */
import Sheet from '../Sheet.astro';
import Action from '../primitives/Action.astro';
import Statement from '../primitives/Statement.astro';
import type { StatementText } from '../primitives/Statement.astro';
import { integrations } from '../../lib/site';

interface Props {
  index?: string;
  label?: string;
  statement: StatementText;
  lead?: string;
  expectations?: readonly string[];
  tone?: 'ink' | 'signal';
  id?: string;
}

const {
  index = '08',
  label = 'Invitation',
  statement,
  lead,
  expectations,
  tone = 'ink',
  id = 'invitation',
} = Astro.props;

const headingId = `${id}-title`;
---

<Sheet id={id} tone={tone} size="open" labelledby={headingId}>
  <div class="invitation field-grid">
    <div class="invitation__head">
      <p class="label invitation__label">{index} / {label}</p>
      <Statement
        class="invitation__statement"
        statement={statement}
        as="h2"
        size={2}
        tone="signal"
        id={headingId}
      />
    </div>

    <div class="invitation__body">
      {lead && <p class="invitation__lead">{lead}</p>}

      {
        expectations && expectations.length > 0 && (
          <ul class="invitation__expectations" role="list">
            {expectations.map((expectation, position) => (
              <li>
                <span class="invitation__step" aria-hidden="true">
                  {String(position + 1).padStart(2, '0')}
                </span>
                {expectation}
              </li>
            ))}
          </ul>
        )
      }

      <div class="invitation__actions">
        <Action href={integrations.booking.url} size="large">Book a call</Action>
        <Action href="/contact/" variant="line">Or send an enquiry</Action>
      </div>

      <p class="invitation__direct">
        Direct: <a href={`mailto:${integrations.contact.email}`}>{integrations.contact.email}</a>
      </p>
    </div>
  </div>
</Sheet>

<style>
  .invitation {
    --field-row-gap: var(--space-2xl);
  }

  .invitation__label {
    margin-block-end: var(--space-m);
    color: var(--ink-soft);
  }

  .invitation__lead {
    max-width: 46ch;
    font-size: var(--step-1);
    line-height: 1.3;
    letter-spacing: var(--track-tight);
    color: var(--ink-soft);
  }

  .invitation__expectations {
    display: grid;
    margin: var(--space-l) 0 0;
    padding: 0;
    list-style: none;
  }

  /* Separators between the steps, and none at either end: a rule is only
     drawn where it divides two things. */
  .invitation__expectations > li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: var(--space-s);
    padding-block: var(--space-s);
    font-size: var(--step--1);
    line-height: 1.4;
  }

  .invitation__expectations > li + li {
    border-block-start: var(--rule-hair) solid var(--rule);
  }

  .invitation__step {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--track-label);
    color: var(--signal);
  }

  .invitation__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m);
    margin-block-start: var(--space-xl);
  }

  .invitation__direct {
    margin-block-start: var(--space-m);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .invitation__direct a {
    color: var(--ink);
    text-decoration-color: var(--signal);
  }

  @media (min-width: 60rem) {
    .invitation {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      column-gap: var(--space-2xl);
      align-items: start;
    }

    .invitation__body {
      padding-block-start: var(--space-l);
    }
  }
</style>
