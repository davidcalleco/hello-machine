---
/**
 * The opening of a page.
 *
 * Two variants, because the routes are not interchangeable and should not
 * open identically:
 *
 *   open      statement runs wide with the note parked in the right margin —
 *             used where the page is an argument (services, about, process)
 *   indexed   a catalogue entry: vertical spine, index number, and the
 *             statement indented into the field — used where the page is one
 *             item out of several (the practice pages)
 *
 * Both share the same grid, rule behaviour and metadata strip, so they read
 * as the same publication.
 */
import Label from '../primitives/Label.astro';
import Spine from '../primitives/Spine.astro';
import Statement from '../primitives/Statement.astro';
import type { StatementText } from '../primitives/Statement.astro';

export interface MetaEntry {
  label: string;
  value: string;
}

interface Props {
  index?: string;
  label: string;
  statement: StatementText;
  /** Heading id, used by the page to label its opening region. */
  id?: string;
  lead?: string;
  note?: string;
  spine?: string;
  meta?: readonly MetaEntry[];
  variant?: 'open' | 'indexed';
  tone?: 'editorial' | 'signal';
  size?: 1 | 2 | 3;
}

const {
  index,
  label,
  statement,
  id = 'page-title',
  lead,
  note,
  spine,
  meta,
  variant = 'open',
  tone = 'editorial',
  size = 2,
} = Astro.props;
---

<div class:list={['masthead-block', `masthead-block--${variant}`]}>
  {spine && <Spine class="masthead-block__spine" text={spine} tone={tone} />}

  <div class="masthead-block__head">
    <Label class="masthead-block__label" index={index} text={label} tone="ink" rule={!index} />
    <Statement
      class="masthead-block__statement"
      statement={statement}
      as="h1"
      size={size}
      tone={tone}
      id={id}
    />
    {lead && <p class="lead masthead-block__lead">{lead}</p>}
  </div>

  {
    note && (
      <p class="note masthead-block__note">
        <span class="masthead-block__note-rule" aria-hidden="true" />
        {note}
      </p>
    )
  }

  {
    meta && meta.length > 0 && (
      <dl class="masthead-block__meta">
        {meta.map((entry) => (
          <div class="masthead-block__meta-cell">
            <dt class="label">{entry.label}</dt>
            <dd class="masthead-block__meta-value">{entry.value}</dd>
          </div>
        ))}
      </dl>
    )
  }
</div>

<style>
  .masthead-block {
    display: grid;
    gap: var(--space-l);
  }

  .masthead-block__label {
    margin-block-end: var(--space-m);
  }

  .masthead-block__lead {
    margin-block-start: var(--space-l);
    max-width: 34ch;
    color: var(--ink-soft);
  }

  .masthead-block__note-rule {
    display: block;
    width: var(--space-l);
    height: var(--rule-heavy);
    margin-block-end: var(--space-2xs);
    background-color: var(--editorial);
  }

  /* The metadata strip: the sheet stating its own coordinates. */
  .masthead-block__meta {
    display: grid;
    gap: var(--space-m);
    margin: 0;
    padding-block-start: var(--space-s);
    border-block-start: var(--rule-hair) solid var(--rule);
  }

  .masthead-block__meta-cell > dt {
    margin-block-end: var(--space-3xs);
  }

  .masthead-block__meta-value {
    margin: 0;
    font-size: var(--step--1);
    letter-spacing: var(--track-tight);
  }

  @media (min-width: 40rem) {
    .masthead-block__meta {
      grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
      gap: var(--space-l);
    }
  }

  @media (min-width: 60rem) {
    .masthead-block--open {
      grid-template-columns: minmax(0, 1fr) var(--width-note);
      column-gap: var(--space-2xl);
      align-items: start;
    }

    .masthead-block--open .masthead-block__note {
      /* Optical alignment with the statement's first baseline rather than
         with the top of its line box. */
      padding-block-start: 0.6em;
    }

    .masthead-block--open .masthead-block__meta {
      grid-column: 1 / -1;
      margin-block-start: var(--space-xl);
    }

    .masthead-block--indexed {
      grid-template-columns: auto minmax(0, 1fr) var(--width-note);
      column-gap: var(--space-l);
      align-items: start;
    }

    .masthead-block--indexed .masthead-block__spine {
      grid-row: 1 / 3;
    }

    .masthead-block--indexed .masthead-block__head {
      /* The entry sits one step into the field: the change of pace that tells
         you this is an item, not the front of the publication. */
      padding-inline-start: 8%;
    }

    .masthead-block--indexed .masthead-block__meta {
      grid-column: 2 / -1;
      margin-block-start: var(--space-xl);
      padding-inline-start: 8%;
    }
  }
</style>
