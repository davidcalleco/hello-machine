---
/**
 * The offer, as an index: three rows to compare, one explanation area below
 * them.
 *
 * Composition rules this obeys, because the previous version broke all of
 * them:
 *
 *   - One rule per boundary. A heavy rule opens the index, hairlines separate
 *     the three rows, a heavy rule closes it and opens the explanation. No
 *     rule sits directly above another, and no rule is decorative.
 *   - Everything lands on the twelve-column field grid: index number, name,
 *     outcome and mark each own known columns, and the explanation's three
 *     groups sit under them.
 *   - The selected row is unmistakable — highlighter fill plus an ink frame —
 *     and the state costs no layout movement, so nothing jitters under the
 *     pointer.
 *
 * Static-first. Without JavaScript this is a list of in-page links above three
 * fully-written entries: every word is present and reachable. The script
 * upgrades it to a tablist — same content, one entry at a time, arrow-key
 * navigation. Nothing animates except a colour.
 */
import Action from '../primitives/Action.astro';
import type { Engagement } from '../../data/types';

interface Props {
  engagements: Engagement[];
  /** Unique within the page — two instruments can coexist. */
  id?: string;
}

const { engagements, id = 'engagement' } = Astro.props;
---

<div class="offer" data-selector>
  <div class="offer__index" data-tablist>
    {
      engagements.map((engagement) => (
        <a
          class="offer__row"
          id={`${id}-tab-${engagement.id}`}
          href={`#${id}-panel-${engagement.id}`}
          data-tab={engagement.id}
        >
          <span class="offer__row-index" aria-hidden="true">
            {engagement.index}
          </span>
          <span class="offer__row-name">{engagement.name}</span>
          <span class="offer__row-line">{engagement.line}</span>
          <span class="offer__row-mark" aria-hidden="true">
            →
          </span>
        </a>
      ))
    }
  </div>

  <div class="offer__explanation">
    {
      engagements.map((engagement) => (
        <article
          class="offer__panel field-grid"
          id={`${id}-panel-${engagement.id}`}
          data-panel={engagement.id}
        >
          <div class="offer__panel-id">
            <p class="label offer__panel-label">{engagement.index} / Selected</p>
            <h3 class="offer__panel-title">{engagement.name}</h3>
            <p class="offer__best">
              <span class="label offer__best-label">Best for</span>
              {engagement.bestFor}
            </p>
          </div>

          <div class="offer__panel-main">
            <p class="offer__summary">{engagement.summary}</p>
            <Action class="offer__action" href={engagement.action.href} variant="ghost">
              {engagement.action.label}
            </Action>
          </div>

          <div class="offer__panel-side">
            <p class="label offer__side-label">What it covers</p>
            <ul class="offer__includes" role="list">
              {engagement.includes.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <p class="offer__boundary">
              <span class="label offer__boundary-label">The boundary</span>
              {engagement.boundary}
            </p>
          </div>
        </article>
      ))
    }
  </div>
</div>

<script>
  // Progressive enhancement. If anything here is unavailable the markup stays
  // exactly as rendered: a link list above three readable entries.
  for (const root of document.querySelectorAll<HTMLElement>('[data-selector]')) {
    const tabs = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-panel]'));
    const list = root.querySelector<HTMLElement>('[data-tablist]');

    if (tabs.length === 0 || tabs.length !== panels.length || !list) continue;

    list.setAttribute('role', 'tablist');
    list.setAttribute('aria-label', 'Ways to work');

    for (const panel of panels) {
      panel.setAttribute('role', 'tabpanel');
      panel.setAttribute('tabindex', '0');
      const key = panel.dataset.panel;
      const tab = tabs.find((candidate) => candidate.dataset.tab === key);
      if (tab) panel.setAttribute('aria-labelledby', tab.id);
    }

    const select = (next: number, focus = false) => {
      tabs.forEach((tab, position) => {
        const active = position === next;
        tab.setAttribute('role', 'tab');
        tab.setAttribute('aria-selected', String(active));
        tab.setAttribute('aria-controls', panels[position].id);
        // Roving tabindex: the tablist is one stop, arrows move within it.
        tab.tabIndex = active ? 0 : -1;
        panels[position].hidden = !active;
      });
      if (focus) tabs[next].focus();
    };

    tabs.forEach((tab, position) => {
      tab.addEventListener('click', (event) => {
        event.preventDefault();
        select(position);
      });

      tab.addEventListener('keydown', (event) => {
        const last = tabs.length - 1;
        let next: number | null = null;

        if (event.key === 'ArrowRight' || event.key === 'ArrowDown')
          next = position + 1 > last ? 0 : position + 1;
        else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp')
          next = position - 1 < 0 ? last : position - 1;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = last;

        if (next === null) return;
        event.preventDefault();
        select(next, true);
      });
    });

    root.setAttribute('data-enhanced', '');
    select(0);
  }
</script>

<style>
  /* =====================================================================
     The index: three rows to choose between
     ===================================================================== */

  .offer__index {
    display: grid;
    border-block-start: var(--rule-heavy) solid var(--rule-strong);
  }

  .offer__row {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) 1.5rem;
    column-gap: var(--space-s);
    align-items: baseline;
    padding-block: var(--space-m);
    border-block-end: var(--rule-hair) solid var(--rule);
    color: var(--ink);
    text-decoration: none;
    cursor: pointer;
    /* Colour only. The row never moves, grows or reflows when it is chosen. */
    transition: background-color var(--duration-fast) var(--ease);
  }

  .offer__row-index {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--track-label);
    color: var(--signal);
  }

  .offer__row-name {
    font-size: var(--step-3);
    font-weight: 500;
    line-height: var(--leading-tight);
    letter-spacing: var(--track-heading);
  }

  .offer__row-line {
    grid-column: 2;
    margin-block-start: var(--space-2xs);
    font-size: var(--step--1);
    line-height: 1.4;
    color: var(--ink-soft);
  }

  .offer__row-mark {
    grid-column: 3;
    grid-row: 1;
    justify-self: end;
    font-size: var(--step-0);
    color: var(--ink-soft);
  }

  /* The selected row: the highlighter, plus an ink frame so the state survives
     on a printout, in high contrast, and for anyone who does not read the
     colour. Hover is the fill alone. */
  .offer__row[aria-selected='true'] {
    background-color: var(--select);
    color: var(--on-select);
    box-shadow: inset 0 0 0 var(--rule-heavy) var(--ink);
  }

  .offer__row[aria-selected='true'] .offer__row-index,
  .offer__row[aria-selected='true'] .offer__row-line,
  .offer__row[aria-selected='true'] .offer__row-mark {
    color: var(--ink);
  }

  @media (hover: hover) {
    .offer__row:hover {
      background-color: var(--select);
      color: var(--on-select);
    }

    .offer__row:hover .offer__row-index,
    .offer__row:hover .offer__row-line,
    .offer__row:hover .offer__row-mark {
      color: var(--ink);
    }
  }

  /* =====================================================================
     The explanation: one area, always in the same place
     ===================================================================== */

  .offer__explanation {
    display: grid;
    gap: var(--space-2xl);
    margin-block-start: var(--space-xl);
  }

  /* Unenhanced, all three entries are written out, so each needs its own
     opening rule. Enhanced, there is only ever one — and the rule belongs to
     the area, not to the entry. */
  [data-enhanced] .offer__explanation {
    gap: 0;
    border-block-start: var(--rule-heavy) solid var(--rule-strong);
    padding-block-start: var(--space-l);
  }

  .offer__panel {
    --field-row-gap: var(--space-l);
    border-block-start: var(--rule-heavy) solid var(--rule-strong);
    padding-block-start: var(--space-l);
  }

  [data-enhanced] .offer__panel {
    border-block-start: 0;
    padding-block-start: 0;
  }

  .offer__panel-label {
    margin-block-end: var(--space-2xs);
  }

  .offer__panel-title {
    font-size: var(--step-2);
    font-weight: 500;
    line-height: var(--leading-tight);
    letter-spacing: var(--track-heading);
  }

  .offer__best {
    margin-block-start: var(--space-m);
    max-width: 30ch;
    font-size: var(--step--1);
    line-height: 1.4;
  }

  .offer__best-label {
    display: block;
    margin-block-end: var(--space-3xs);
    color: var(--editorial);
  }

  .offer__summary {
    max-width: 46ch;
    font-size: var(--step-0);
    line-height: 1.45;
    color: var(--ink-soft);
  }

  .offer__action {
    margin-block-start: var(--space-l);
  }

  .offer__side-label,
  .offer__boundary-label {
    display: block;
    margin-block-end: var(--space-2xs);
  }

  .offer__includes {
    display: grid;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    max-width: 42ch;
  }

  .offer__includes > li {
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr);
    gap: var(--space-2xs);
    font-size: var(--step--1);
    line-height: 1.4;
  }

  .offer__includes > li::before {
    content: '+';
    font-family: var(--font-mono);
    color: var(--signal);
  }

  .offer__boundary {
    margin-block-start: var(--space-l);
    max-width: 42ch;
    font-size: var(--step--1);
    line-height: 1.4;
    color: var(--ink-soft);
  }

  .offer__boundary-label {
    color: var(--editorial);
  }

  @media (min-width: 60rem) {
    /* The row's parts take known columns of the field grid, so the index
       reads down as three straight columns rather than as three paragraphs. */
    .offer__row {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--grid-gap);
      align-items: center;
      padding-block: var(--space-l);
    }

    .offer__row-index {
      grid-column: 1;
    }

    .offer__row-name {
      grid-column: 2 / span 5;
      font-size: var(--step-4);
      line-height: var(--leading-display);
      letter-spacing: var(--track-display);
    }

    .offer__row-line {
      grid-column: 7 / span 5;
      grid-row: 1;
      margin-block-start: 0;
      max-width: 34ch;
    }

    .offer__row-mark {
      grid-column: 12;
      font-size: var(--step-1);
    }

    /* Three groups under the three columns above them. */
    .offer__panel-id {
      grid-column: 1 / span 3;
    }

    .offer__panel-main {
      grid-column: 4 / span 5;
    }

    .offer__panel-side {
      grid-column: 9 / span 4;
    }
  }
</style>
