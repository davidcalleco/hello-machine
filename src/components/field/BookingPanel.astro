---
/**
 * The primary conversion: book a call.
 *
 * The scheduler is not provisioned yet (see PROJECT-BRIEF.md blocker 4). This
 * component therefore reads `integrations.booking` and renders one of two
 * honest states:
 *
 *   configured    the action links straight out to the scheduler
 *   pending       the action routes to the enquiry form, and the panel says
 *                 plainly that online scheduling is still being connected
 *
 * When PUBLIC_BOOKING_URL is set the panel switches by itself. There is no
 * fake calendar embed and no dead button in either state.
 *
 * INTEGRATION SLOT — when HubSpot Meetings (or whichever scheduler is chosen)
 * is approved, drop the embed inside `.booking__slot` and leave the rest.
 */
import Action from '../primitives/Action.astro';
import { booking } from '../../data/contact';
import { integrations } from '../../lib/site';

interface Props {
  id?: string;
  headingId?: string;
  /** Where the action points while no scheduler exists. */
  fallbackHref?: string;
}

const { id = 'book', headingId = 'booking-title', fallbackHref = '#enquiry' } = Astro.props;
const configured = integrations.booking.isConfigured;
const href = configured ? integrations.booking.url : fallbackHref;
---

<div class="booking" id={id}>
  <div class="booking__head">
    <p class="label booking__label">{booking.index} / {booking.label}</p>
    <h2 class="booking__title" id={headingId}>{booking.title}</h2>
    <p class="booking__lead">{booking.lead}</p>
  </div>

  <div class="booking__slot">
    <ol class="booking__expectations" role="list">
      {
        booking.expectations.map((expectation, position) => (
          <li>
            <span class="booking__step" aria-hidden="true">
              {String(position + 1).padStart(2, '0')}
            </span>
            {expectation}
          </li>
        ))
      }
    </ol>

    <div class="booking__actions">
      <Action href={href} size="large">
        {configured ? 'Book a call' : 'Request times'}
      </Action>
      {!configured && <p class="booking__pending">{booking.pendingNote}</p>}
    </div>
  </div>
</div>

<style>
  .booking {
    display: grid;
    gap: var(--space-xl);
  }

  .booking__label {
    color: var(--ink-soft);
  }

  .booking__title {
    margin-block-start: var(--space-2xs);
    font-size: var(--step-5);
    font-weight: 500;
    line-height: var(--leading-display);
    letter-spacing: var(--track-display);
  }

  .booking__lead {
    margin-block-start: var(--space-m);
    max-width: 30ch;
    font-size: var(--step-1);
    line-height: 1.28;
    letter-spacing: var(--track-tight);
  }

  .booking__slot {
    display: grid;
    gap: var(--space-l);
    align-content: start;
  }

  .booking__expectations {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-start: var(--rule-hair) solid var(--rule);
  }

  .booking__expectations > li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: var(--space-s);
    padding-block: var(--space-s);
    border-block-end: var(--rule-hair) solid var(--rule);
    font-size: var(--step--1);
    line-height: 1.4;
  }

  .booking__step {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--track-label);
    color: var(--signal);
  }

  .booking__actions {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
  }

  .booking__pending {
    max-width: 44ch;
    padding-inline-start: var(--space-m);
    border-inline-start: var(--rule-heavy) solid var(--editorial);
    font-size: var(--step--1);
    line-height: 1.4;
    color: var(--ink-soft);
  }

  @media (min-width: 60rem) {
    .booking {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: var(--space-2xl);
      align-items: start;
    }
  }
</style>
