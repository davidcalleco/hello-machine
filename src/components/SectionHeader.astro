---
/**
 * Standard section opening: mono label, display heading, optional lead.
 * Used by every section so the page has one consistent entry rhythm.
 */
interface Props {
  label: string;
  title: string;
  id: string;
  lead?: string;
  align?: 'start' | 'wide';
}

const { label, title, id, lead, align = 'start' } = Astro.props;
---

<header class:list={['section-header', `section-header--${align}`]} data-reveal>
  <p class="label section-header__label">{label}</p>
  <h2 id={id} class="section-header__title">{title}</h2>
  {lead && <p class="lead section-header__lead">{lead}</p>}
</header>

<style>
  .section-header {
    display: grid;
    gap: var(--space-s);
    margin-block-end: var(--space-2xl);
  }

  .section-header__label {
    /* Hairline tick aligns the label with the grid rules elsewhere. */
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .section-header__label::before {
    content: '';
    width: var(--space-l);
    height: var(--rule-width);
    background-color: var(--accent);
  }

  .section-header__title {
    max-width: 22ch;
  }

  .section-header--wide .section-header__title {
    max-width: 30ch;
  }

  .section-header__lead {
    margin-block-start: var(--space-2xs);
  }

  @media (min-width: 60rem) {
    .section-header {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: end;
      column-gap: var(--space-2xl);
    }

    .section-header__label {
      grid-column: 1 / -1;
    }

    .section-header__lead {
      margin-block-start: 0;
      padding-block-end: 0.35em;
    }
  }
</style>
