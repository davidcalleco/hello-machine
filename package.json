{
  "name": "hellomachine-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write \"**/*.{astro,ts,js,mjs,css,md,json}\"",
    "format:check": "prettier --check \"**/*.{astro,ts,js,mjs,css,md,json}\"",
    "verify": "npm run format:check && npm run check && npm run build",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "esbuild": true
  }
}
